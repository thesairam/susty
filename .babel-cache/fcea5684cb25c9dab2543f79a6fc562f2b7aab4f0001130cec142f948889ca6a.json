{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/esnext.set.difference.v2.js\";\nimport \"core-js/modules/esnext.set.intersection.v2.js\";\nimport \"core-js/modules/esnext.set.is-disjoint-from.v2.js\";\nimport \"core-js/modules/esnext.set.is-subset-of.v2.js\";\nimport \"core-js/modules/esnext.set.is-superset-of.v2.js\";\nimport \"core-js/modules/esnext.set.symmetric-difference.v2.js\";\nimport \"core-js/modules/esnext.set.union.v2.js\";\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      posts: [],\n      newPost: {\n        content: '',\n        mediaType: '',\n        mediaUrl: ''\n      },\n      feedTab: 'latest',\n      expandedPosts: [],\n      replyInputs: {},\n      openMenu: null,\n      filterTag: ''\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User';\n    },\n    currentUserInitial() {\n      return this.getInitial(this.currentUserName);\n    },\n    canPost() {\n      return this.newPost.content.trim().length > 0;\n    },\n    totalPosts() {\n      return this.posts.length;\n    },\n    activeUsers() {\n      const users = new Set(this.posts.map(p => p.author));\n      return Math.max(users.size, 1);\n    },\n    co2Saved() {\n      return (this.posts.length * 0.3).toFixed(1);\n    },\n    filteredPosts() {\n      let result = [...this.posts];\n      if (this.filterTag) {\n        result = result.filter(p => p.hashtags && p.hashtags.includes(this.filterTag));\n      }\n      if (this.feedTab === 'trending') {\n        result.sort((a, b) => (b.likes || 0) - (a.likes || 0));\n      }\n      return result;\n    }\n  },\n  created() {\n    this.loadPosts();\n    document.addEventListener('click', this.closeMenus);\n  },\n  beforeUnmount() {\n    document.removeEventListener('click', this.closeMenus);\n  },\n  methods: {\n    extractHashtags(text) {\n      const matches = text.match(/#\\w+/g);\n      return matches || [];\n    },\n    renderContent(text) {\n      if (!text) return '';\n      return text.replace(/#(\\w+)/g, '<span class=\"hashtag\">#$1</span>');\n    },\n    getInitial(name) {\n      if (!name) return '?';\n      return name.charAt(0).toUpperCase();\n    },\n    timeAgo(dateStr) {\n      const date = new Date(dateStr);\n      const now = new Date();\n      const diff = Math.floor((now - date) / 1000);\n      if (diff < 60) return 'just now';\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';\n      if (diff < 604800) return Math.floor(diff / 86400) + 'd ago';\n      return date.toLocaleDateString();\n    },\n    toggleMediaType(type) {\n      this.newPost.mediaType = this.newPost.mediaType === type ? '' : type;\n      if (!this.newPost.mediaType) this.newPost.mediaUrl = '';\n    },\n    createPost() {\n      if (!this.canPost) return;\n      const post = {\n        id: Date.now(),\n        author: this.currentUserName,\n        content: this.newPost.content.trim(),\n        hashtags: this.extractHashtags(this.newPost.content),\n        mediaType: this.newPost.mediaType || null,\n        mediaUrl: this.newPost.mediaUrl || null,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        reposts: 0,\n        replies: [],\n        carbonImpact: this.newPost.content.toLowerCase().includes('#zerowaste') ? 'Zero Waste Post' : null\n      };\n      this.posts.unshift(post);\n      this.savePosts();\n      this.newPost = {\n        content: '',\n        mediaType: '',\n        mediaUrl: ''\n      };\n    },\n    toggleLike(post) {\n      post.liked = !post.liked;\n      post.likes = (post.likes || 0) + (post.liked ? 1 : -1);\n      this.savePosts();\n    },\n    toggleReplyLike(post, reply) {\n      reply.liked = !reply.liked;\n      reply.likes = (reply.likes || 0) + (reply.liked ? 1 : -1);\n      this.savePosts();\n    },\n    repost(post) {\n      post.reposts = (post.reposts || 0) + 1;\n      const repost = {\n        id: Date.now(),\n        author: this.currentUserName,\n        content: `🔄 Reposted from ${post.author}: \"${post.content}\"`,\n        hashtags: post.hashtags,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        reposts: 0,\n        replies: [],\n        isRepost: true,\n        originalAuthor: post.author\n      };\n      this.posts.unshift(repost);\n      this.savePosts();\n    },\n    sharePost(post) {\n      if (navigator.clipboard) {\n        navigator.clipboard.writeText(post.content);\n      }\n    },\n    toggleReplies(postId) {\n      const idx = this.expandedPosts.indexOf(postId);\n      if (idx >= 0) {\n        this.expandedPosts.splice(idx, 1);\n      } else {\n        this.expandedPosts.push(postId);\n      }\n    },\n    addReply(post) {\n      const text = (this.replyInputs[post.id] || '').trim();\n      if (!text) return;\n      if (!post.replies) post.replies = [];\n      post.replies.push({\n        id: Date.now(),\n        author: this.currentUserName,\n        content: text,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false\n      });\n      this.replyInputs[post.id] = '';\n      this.savePosts();\n    },\n    togglePostMenu(postId) {\n      this.openMenu = this.openMenu === postId ? null : postId;\n    },\n    closeMenus() {\n      this.openMenu = null;\n    },\n    deletePost(postId) {\n      this.posts = this.posts.filter(p => p.id !== postId);\n      this.savePosts();\n      this.openMenu = null;\n    },\n    reportPost(postId) {\n      this.openMenu = null;\n      const reports = JSON.parse(localStorage.getItem('susty_reports') || '[]');\n      reports.push({\n        postId,\n        date: new Date().toISOString(),\n        reporter: this.currentUserName\n      });\n      localStorage.setItem('susty_reports', JSON.stringify(reports));\n    },\n    filterByTag(tag) {\n      this.filterTag = this.filterTag === tag ? '' : tag;\n    },\n    loadPosts() {\n      const saved = localStorage.getItem('susty_posts');\n      if (saved) {\n        this.posts = JSON.parse(saved);\n      }\n    },\n    savePosts() {\n      localStorage.setItem('susty_posts', JSON.stringify(this.posts));\n    }\n  }\n};","map":{"version":3,"names":["name","data","posts","newPost","content","mediaType","mediaUrl","feedTab","expandedPosts","replyInputs","openMenu","filterTag","computed","currentUser","JSON","parse","localStorage","getItem","currentUserName","email","currentUserInitial","getInitial","canPost","trim","length","totalPosts","activeUsers","users","Set","map","p","author","Math","max","size","co2Saved","toFixed","filteredPosts","result","filter","hashtags","includes","sort","a","b","likes","created","loadPosts","document","addEventListener","closeMenus","beforeUnmount","removeEventListener","methods","extractHashtags","text","matches","match","renderContent","replace","charAt","toUpperCase","timeAgo","dateStr","date","Date","now","diff","floor","toLocaleDateString","toggleMediaType","type","createPost","post","id","toISOString","liked","reposts","replies","carbonImpact","toLowerCase","unshift","savePosts","toggleLike","toggleReplyLike","reply","repost","isRepost","originalAuthor","sharePost","navigator","clipboard","writeText","toggleReplies","postId","idx","indexOf","splice","push","addReply","togglePostMenu","deletePost","reportPost","reports","reporter","setItem","stringify","filterByTag","tag","saved"],"sources":["/home/rare/projects/susty/src/views/Home.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <!-- Hero Section -->\n    <section class=\"hero\">\n      <h1>Welcome to Susty</h1>\n      <p class=\"tagline\">A Better Social Media, A Better World!</p>\n      <p class=\"hero-sub\">Share ideas, take action, and build a sustainable future together.</p>\n      <div class=\"hero-stats\">\n        <div class=\"hero-stat\"><strong>{{ totalPosts }}</strong> Posts</div>\n        <div class=\"hero-stat\"><strong>{{ activeUsers }}</strong> Active</div>\n        <div class=\"hero-stat\"><strong>{{ co2Saved }}</strong> kg CO₂ Saved</div>\n      </div>\n    </section>\n\n    <!-- Quick Features -->\n    <section class=\"quick-features\">\n      <router-link to=\"/marketplace\" class=\"qf-card\">\n        <span class=\"qf-icon\">🛒</span>\n        <span>Marketplace</span>\n      </router-link>\n      <router-link to=\"/events\" class=\"qf-card\">\n        <span class=\"qf-icon\">📅</span>\n        <span>Events</span>\n      </router-link>\n      <router-link to=\"/challenges\" class=\"qf-card\">\n        <span class=\"qf-icon\">🏆</span>\n        <span>Challenges</span>\n      </router-link>\n      <router-link to=\"/knowledge\" class=\"qf-card\">\n        <span class=\"qf-icon\">📚</span>\n        <span>Knowledge</span>\n      </router-link>\n      <router-link to=\"/donations\" class=\"qf-card\">\n        <span class=\"qf-icon\">🎁</span>\n        <span>Donations</span>\n      </router-link>\n    </section>\n\n    <!-- Compose Post -->\n    <section class=\"compose card\">\n      <div class=\"compose-header\">\n        <div class=\"avatar\">{{ currentUserInitial }}</div>\n        <div class=\"compose-body\">\n          <input\n            v-model=\"newPost.content\"\n            :placeholder=\"'What\\'s on your mind about sustainability, ' + currentUserName + '?'\"\n            class=\"compose-input\"\n            @keyup.enter=\"createPost\"\n          />\n        </div>\n      </div>\n      <div class=\"compose-actions\">\n        <div class=\"compose-tools\">\n          <button class=\"tool-btn\" title=\"Add image\" @click=\"toggleMediaType('image')\">🖼️ Photo</button>\n          <button class=\"tool-btn\" title=\"Add video\" @click=\"toggleMediaType('video')\">🎬 Video</button>\n          <button class=\"tool-btn\" title=\"Add link\" @click=\"toggleMediaType('link')\">🔗 Link</button>\n        </div>\n        <button class=\"btn btn-primary\" @click=\"createPost\" :disabled=\"!canPost\">Post</button>\n      </div>\n      <div v-if=\"newPost.mediaType\" class=\"compose-media-input\">\n        <input\n          v-model=\"newPost.mediaUrl\"\n          :placeholder=\"'Paste ' + newPost.mediaType + ' URL...'\"\n          class=\"form-input\"\n        />\n        <button class=\"btn btn-sm btn-outline\" @click=\"newPost.mediaType = ''; newPost.mediaUrl = ''\">✕</button>\n      </div>\n      <div v-if=\"newPost.content && extractHashtags(newPost.content).length\" class=\"compose-tags\">\n        <span class=\"badge badge-green\" v-for=\"tag in extractHashtags(newPost.content)\" :key=\"tag\">{{ tag }}</span>\n      </div>\n    </section>\n\n    <!-- Feed Tabs -->\n    <div class=\"tabs\">\n      <button class=\"tab\" :class=\"{ active: feedTab === 'latest' }\" @click=\"feedTab = 'latest'\">Latest</button>\n      <button class=\"tab\" :class=\"{ active: feedTab === 'trending' }\" @click=\"feedTab = 'trending'\">Trending</button>\n      <button class=\"tab\" :class=\"{ active: feedTab === 'following' }\" @click=\"feedTab = 'following'\">Following</button>\n    </div>\n\n    <!-- Posts Feed -->\n    <section class=\"feed\">\n      <div v-if=\"filteredPosts.length === 0\" class=\"empty-state\">\n        <div class=\"empty-state-icon\">🌱</div>\n        <p>No posts yet. Be the first to share something sustainable!</p>\n      </div>\n\n      <div v-for=\"post in filteredPosts\" :key=\"post.id\" class=\"post-card card\">\n        <!-- Post Header -->\n        <div class=\"post-header\">\n          <div class=\"avatar\" :style=\"{ background: post.avatarColor || '' }\">{{ getInitial(post.author) }}</div>\n          <div class=\"post-meta\">\n            <strong class=\"post-author\">{{ post.author }}</strong>\n            <span class=\"post-time\">{{ timeAgo(post.date) }}</span>\n          </div>\n          <div class=\"post-menu\">\n            <button class=\"icon-btn\" @click=\"togglePostMenu(post.id)\">⋯</button>\n            <div v-if=\"openMenu === post.id\" class=\"post-dropdown\">\n              <button @click=\"deletePost(post.id)\">🗑️ Delete</button>\n              <button @click=\"reportPost(post.id)\">🚩 Report</button>\n            </div>\n          </div>\n        </div>\n\n        <!-- Post Content -->\n        <div class=\"post-content\">\n          <p v-html=\"renderContent(post.content)\"></p>\n          <div v-if=\"post.mediaUrl\" class=\"post-media\">\n            <div v-if=\"post.mediaType === 'image'\" class=\"media-placeholder media-image\">🖼️ {{ post.mediaUrl }}</div>\n            <div v-else-if=\"post.mediaType === 'video'\" class=\"media-placeholder media-video\">🎬 {{ post.mediaUrl }}</div>\n            <div v-else-if=\"post.mediaType === 'link'\" class=\"media-placeholder media-link\">🔗 {{ post.mediaUrl }}</div>\n          </div>\n        </div>\n\n        <!-- Post Tags -->\n        <div v-if=\"post.hashtags && post.hashtags.length\" class=\"post-tags\">\n          <span class=\"hashtag\" v-for=\"tag in post.hashtags\" :key=\"tag\" @click=\"filterByTag(tag)\">{{ tag }}</span>\n        </div>\n\n        <!-- Carbon Impact -->\n        <div v-if=\"post.carbonImpact\" class=\"carbon-badge\">\n          <span class=\"badge badge-green\">🌿 {{ post.carbonImpact }}</span>\n        </div>\n\n        <!-- Post Actions -->\n        <div class=\"post-actions\">\n          <button class=\"action-btn\" :class=\"{ liked: post.liked }\" @click=\"toggleLike(post)\">\n            {{ post.liked ? '❤️' : '🤍' }} {{ post.likes || 0 }}\n          </button>\n          <button class=\"action-btn\" @click=\"toggleReplies(post.id)\">\n            💬 {{ (post.replies || []).length }}\n          </button>\n          <button class=\"action-btn\" @click=\"repost(post)\">\n            🔄 {{ post.reposts || 0 }}\n          </button>\n          <button class=\"action-btn\" @click=\"sharePost(post)\">\n            📤 Share\n          </button>\n        </div>\n\n        <!-- Replies Section -->\n        <div v-if=\"expandedPosts.includes(post.id)\" class=\"replies-section\">\n          <div v-for=\"reply in (post.replies || [])\" :key=\"reply.id\" class=\"reply\">\n            <div class=\"reply-header\">\n              <div class=\"avatar avatar-sm\">{{ getInitial(reply.author) }}</div>\n              <strong>{{ reply.author }}</strong>\n              <span class=\"post-time\">{{ timeAgo(reply.date) }}</span>\n            </div>\n            <p class=\"reply-content\" v-html=\"renderContent(reply.content)\"></p>\n            <button class=\"action-btn action-btn-sm\" :class=\"{ liked: reply.liked }\" @click=\"toggleReplyLike(post, reply)\">\n              {{ reply.liked ? '❤️' : '🤍' }} {{ reply.likes || 0 }}\n            </button>\n          </div>\n          <div class=\"reply-compose\">\n            <input\n              v-model=\"replyInputs[post.id]\"\n              placeholder=\"Write a reply...\"\n              class=\"form-input\"\n              @keyup.enter=\"addReply(post)\"\n            />\n            <button class=\"btn btn-sm btn-primary\" @click=\"addReply(post)\">Reply</button>\n          </div>\n        </div>\n      </div>\n    </section>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'HomeView',\n  data() {\n    return {\n      posts: [],\n      newPost: {\n        content: '',\n        mediaType: '',\n        mediaUrl: ''\n      },\n      feedTab: 'latest',\n      expandedPosts: [],\n      replyInputs: {},\n      openMenu: null,\n      filterTag: ''\n    }\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {}\n      } catch { return {} }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User'\n    },\n    currentUserInitial() {\n      return this.getInitial(this.currentUserName)\n    },\n    canPost() {\n      return this.newPost.content.trim().length > 0\n    },\n    totalPosts() {\n      return this.posts.length\n    },\n    activeUsers() {\n      const users = new Set(this.posts.map(p => p.author))\n      return Math.max(users.size, 1)\n    },\n    co2Saved() {\n      return (this.posts.length * 0.3).toFixed(1)\n    },\n    filteredPosts() {\n      let result = [...this.posts]\n      if (this.filterTag) {\n        result = result.filter(p => p.hashtags && p.hashtags.includes(this.filterTag))\n      }\n      if (this.feedTab === 'trending') {\n        result.sort((a, b) => (b.likes || 0) - (a.likes || 0))\n      }\n      return result\n    }\n  },\n  created() {\n    this.loadPosts()\n    document.addEventListener('click', this.closeMenus)\n  },\n  beforeUnmount() {\n    document.removeEventListener('click', this.closeMenus)\n  },\n  methods: {\n    extractHashtags(text) {\n      const matches = text.match(/#\\w+/g)\n      return matches || []\n    },\n    renderContent(text) {\n      if (!text) return ''\n      return text.replace(/#(\\w+)/g, '<span class=\"hashtag\">#$1</span>')\n    },\n    getInitial(name) {\n      if (!name) return '?'\n      return name.charAt(0).toUpperCase()\n    },\n    timeAgo(dateStr) {\n      const date = new Date(dateStr)\n      const now = new Date()\n      const diff = Math.floor((now - date) / 1000)\n      if (diff < 60) return 'just now'\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago'\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago'\n      if (diff < 604800) return Math.floor(diff / 86400) + 'd ago'\n      return date.toLocaleDateString()\n    },\n    toggleMediaType(type) {\n      this.newPost.mediaType = this.newPost.mediaType === type ? '' : type\n      if (!this.newPost.mediaType) this.newPost.mediaUrl = ''\n    },\n    createPost() {\n      if (!this.canPost) return\n      const post = {\n        id: Date.now(),\n        author: this.currentUserName,\n        content: this.newPost.content.trim(),\n        hashtags: this.extractHashtags(this.newPost.content),\n        mediaType: this.newPost.mediaType || null,\n        mediaUrl: this.newPost.mediaUrl || null,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        reposts: 0,\n        replies: [],\n        carbonImpact: this.newPost.content.toLowerCase().includes('#zerowaste') ? 'Zero Waste Post' : null\n      }\n      this.posts.unshift(post)\n      this.savePosts()\n      this.newPost = { content: '', mediaType: '', mediaUrl: '' }\n    },\n    toggleLike(post) {\n      post.liked = !post.liked\n      post.likes = (post.likes || 0) + (post.liked ? 1 : -1)\n      this.savePosts()\n    },\n    toggleReplyLike(post, reply) {\n      reply.liked = !reply.liked\n      reply.likes = (reply.likes || 0) + (reply.liked ? 1 : -1)\n      this.savePosts()\n    },\n    repost(post) {\n      post.reposts = (post.reposts || 0) + 1\n      const repost = {\n        id: Date.now(),\n        author: this.currentUserName,\n        content: `🔄 Reposted from ${post.author}: \"${post.content}\"`,\n        hashtags: post.hashtags,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        reposts: 0,\n        replies: [],\n        isRepost: true,\n        originalAuthor: post.author\n      }\n      this.posts.unshift(repost)\n      this.savePosts()\n    },\n    sharePost(post) {\n      if (navigator.clipboard) {\n        navigator.clipboard.writeText(post.content)\n      }\n    },\n    toggleReplies(postId) {\n      const idx = this.expandedPosts.indexOf(postId)\n      if (idx >= 0) {\n        this.expandedPosts.splice(idx, 1)\n      } else {\n        this.expandedPosts.push(postId)\n      }\n    },\n    addReply(post) {\n      const text = (this.replyInputs[post.id] || '').trim()\n      if (!text) return\n      if (!post.replies) post.replies = []\n      post.replies.push({\n        id: Date.now(),\n        author: this.currentUserName,\n        content: text,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false\n      })\n      this.replyInputs[post.id] = ''\n      this.savePosts()\n    },\n    togglePostMenu(postId) {\n      this.openMenu = this.openMenu === postId ? null : postId\n    },\n    closeMenus() {\n      this.openMenu = null\n    },\n    deletePost(postId) {\n      this.posts = this.posts.filter(p => p.id !== postId)\n      this.savePosts()\n      this.openMenu = null\n    },\n    reportPost(postId) {\n      this.openMenu = null\n      const reports = JSON.parse(localStorage.getItem('susty_reports') || '[]')\n      reports.push({ postId, date: new Date().toISOString(), reporter: this.currentUserName })\n      localStorage.setItem('susty_reports', JSON.stringify(reports))\n    },\n    filterByTag(tag) {\n      this.filterTag = this.filterTag === tag ? '' : tag\n    },\n    loadPosts() {\n      const saved = localStorage.getItem('susty_posts')\n      if (saved) {\n        this.posts = JSON.parse(saved)\n      }\n    },\n    savePosts() {\n      localStorage.setItem('susty_posts', JSON.stringify(this.posts))\n    }\n  }\n}\n</script>\n\n<style scoped>\n.hero {\n  background: linear-gradient(135deg, var(--primary-green), var(--primary-blue));\n  color: white;\n  text-align: center;\n  padding: 3rem 2rem;\n  border-radius: var(--radius-lg);\n  margin-bottom: 1.5rem;\n}\n.hero h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }\n.tagline { font-size: 1.2rem; opacity: 0.95; margin: 0; }\n.hero-sub { opacity: 0.85; margin: 0.5rem 0 1.5rem; }\n.hero-stats { display: flex; justify-content: center; gap: 2rem; }\n.hero-stat { font-size: 0.95rem; }\n.hero-stat strong { font-size: 1.3rem; display: block; }\n\n/* Quick Features */\n.quick-features {\n  display: flex;\n  gap: 1rem;\n  margin-bottom: 1.5rem;\n  overflow-x: auto;\n  padding-bottom: 0.5rem;\n}\n.qf-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.8rem 1.2rem;\n  background: white;\n  border-radius: var(--radius-md);\n  box-shadow: var(--card-shadow);\n  text-decoration: none;\n  color: var(--dark-text);\n  font-size: 0.85rem;\n  font-weight: 500;\n  white-space: nowrap;\n  transition: all var(--transition);\n  flex-shrink: 0;\n}\n.qf-card:hover { transform: translateY(-2px); box-shadow: var(--card-shadow-hover); }\n.qf-icon { font-size: 1.5rem; }\n\n/* Compose */\n.compose { margin-bottom: 1.5rem; }\n.compose-header { display: flex; align-items: center; gap: 0.75rem; }\n.compose-body { flex: 1; }\n.compose-input {\n  width: 100%;\n  border: none;\n  font-size: 1rem;\n  padding: 0.5rem 0;\n  background: transparent;\n  color: var(--dark-text);\n  outline: none;\n}\n.compose-actions {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 0.75rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--border-color);\n}\n.compose-tools { display: flex; gap: 0.25rem; }\n.tool-btn {\n  background: none;\n  border: none;\n  padding: 0.4rem 0.65rem;\n  border-radius: var(--radius-sm);\n  cursor: pointer;\n  font-size: 0.85rem;\n  color: var(--muted-text);\n  transition: all var(--transition);\n}\n.tool-btn:hover { background: var(--light-green); color: var(--primary-green); }\n.compose-media-input {\n  display: flex;\n  gap: 0.5rem;\n  margin-top: 0.75rem;\n}\n.compose-tags { display: flex; gap: 0.5rem; margin-top: 0.5rem; flex-wrap: wrap; }\n\n/* Post Card */\n.post-card { margin-bottom: 1rem; }\n.post-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }\n.post-meta { flex: 1; }\n.post-author { font-size: 0.95rem; }\n.post-time { display: block; font-size: 0.8rem; color: var(--muted-text); }\n.post-menu { position: relative; }\n.icon-btn {\n  background: none;\n  border: none;\n  font-size: 1.2rem;\n  cursor: pointer;\n  padding: 0.25rem 0.5rem;\n  border-radius: var(--radius-sm);\n  color: var(--muted-text);\n}\n.icon-btn:ho