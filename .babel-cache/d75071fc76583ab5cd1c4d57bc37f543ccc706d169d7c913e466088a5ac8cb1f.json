{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'EventsView',\n  data() {\n    return {\n      showCreateForm: false,\n      viewMode: 'upcoming',\n      catFilter: '',\n      events: [],\n      newEvent: {\n        name: '',\n        category: '',\n        date: '',\n        time: '',\n        location: '',\n        ticketType: 'free',\n        price: 0,\n        description: ''\n      },\n      eventCategories: [{\n        id: 'cleanup',\n        name: 'Cleanups',\n        icon: '🧹'\n      }, {\n        id: 'march',\n        name: 'Climate Marches',\n        icon: '✊'\n      }, {\n        id: 'workshop',\n        name: 'Workshops',\n        icon: '🛠️'\n      }, {\n        id: 'repair',\n        name: 'Repair Cafés',\n        icon: '🔧'\n      }, {\n        id: 'planting',\n        name: 'Tree Planting',\n        icon: '🌳'\n      }, {\n        id: 'market',\n        name: 'Eco Markets',\n        icon: '🏪'\n      }, {\n        id: 'talk',\n        name: 'Talks & Panels',\n        icon: '🎤'\n      }]\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    canCreate() {\n      return this.newEvent.name.trim() && this.newEvent.category && this.newEvent.date && this.newEvent.location.trim();\n    },\n    filteredEvents() {\n      const now = new Date().toISOString().split('T')[0];\n      let result = [...this.events];\n      if (this.viewMode === 'upcoming') {\n        result = result.filter(e => e.date >= now);\n      } else if (this.viewMode === 'past') {\n        result = result.filter(e => e.date < now);\n      } else if (this.viewMode === 'my') {\n        const name = this.currentUser.name || this.currentUser.email || '';\n        result = result.filter(e => e.organizer === name || e.rsvped);\n      }\n      if (this.catFilter) {\n        result = result.filter(e => e.category === this.catFilter);\n      }\n      result.sort((a, b) => a.date.localeCompare(b.date));\n      return result;\n    }\n  },\n  created() {\n    this.loadEvents();\n  },\n  methods: {\n    getCatIcon(id) {\n      const cat = this.eventCategories.find(c => c.id === id);\n      return cat ? cat.icon : '📅';\n    },\n    getCatName(id) {\n      const cat = this.eventCategories.find(c => c.id === id);\n      return cat ? cat.name : 'Event';\n    },\n    getCatColor(id) {\n      const colors = {\n        cleanup: 'linear-gradient(135deg, #4CAF50, #66BB6A)',\n        march: 'linear-gradient(135deg, #e53935, #ef5350)',\n        workshop: 'linear-gradient(135deg, #FF9800, #FFB74D)',\n        repair: 'linear-gradient(135deg, #795548, #a1887f)',\n        planting: 'linear-gradient(135deg, #2E7D32, #43A047)',\n        market: 'linear-gradient(135deg, #7B1FA2, #AB47BC)',\n        talk: 'linear-gradient(135deg, #1565C0, #42A5F5)'\n      };\n      return colors[id] || 'linear-gradient(135deg, #607D8B, #90A4AE)';\n    },\n    formatMonth(dateStr) {\n      if (!dateStr) return '';\n      const d = new Date(dateStr + 'T00:00:00');\n      return d.toLocaleString('en', {\n        month: 'short'\n      }).toUpperCase();\n    },\n    formatDay(dateStr) {\n      if (!dateStr) return '';\n      const d = new Date(dateStr + 'T00:00:00');\n      return d.getDate();\n    },\n    createEvent() {\n      if (!this.canCreate) return;\n      const event = {\n        id: Date.now(),\n        name: this.newEvent.name.trim(),\n        category: this.newEvent.category,\n        date: this.newEvent.date,\n        time: this.newEvent.time || '10:00',\n        location: this.newEvent.location.trim(),\n        ticketType: this.newEvent.ticketType,\n        price: this.newEvent.ticketType === 'paid' ? Number(this.newEvent.price) || 0 : 0,\n        description: this.newEvent.description.trim(),\n        organizer: this.currentUser.name || this.currentUser.email || 'Anonymous',\n        rsvps: 0,\n        rsvped: false,\n        createdAt: new Date().toISOString()\n      };\n      this.events.push(event);\n      this.saveEvents();\n      this.showCreateForm = false;\n      this.newEvent = {\n        name: '',\n        category: '',\n        date: '',\n        time: '',\n        location: '',\n        ticketType: 'free',\n        price: 0,\n        description: ''\n      };\n    },\n    rsvp(event) {\n      event.rsvped = true;\n      event.rsvps = (event.rsvps || 0) + 1;\n      this.saveEvents();\n    },\n    cancelRsvp(event) {\n      event.rsvped = false;\n      event.rsvps = Math.max(0, (event.rsvps || 1) - 1);\n      this.saveEvents();\n    },\n    loadEvents() {\n      const saved = localStorage.getItem('susty_events');\n      if (saved) {\n        this.events = JSON.parse(saved);\n      } else {\n        this.events = [{\n          id: 1,\n          name: 'Beach Cleanup Day',\n          category: 'cleanup',\n          date: '2026-04-12',\n          time: '09:00',\n          location: 'Santa Monica Beach, CA',\n          ticketType: 'free',\n          price: 0,\n          description: 'Join us for a community beach cleanup! Bring gloves and sunscreen. Trash bags provided.',\n          organizer: 'OceanGuards',\n          rsvps: 42,\n          rsvped: false\n        }, {\n          id: 2,\n          name: 'Zero Waste Workshop',\n          category: 'workshop',\n          date: '2026-04-18',\n          time: '14:00',\n          location: 'Green Community Center, Portland',\n          ticketType: 'paid',\n          price: 15,\n          description: 'Learn practical tips to reduce household waste by 80%. Hands-on activities included.',\n          organizer: 'ZeroWastePortland',\n          rsvps: 28,\n          rsvped: false\n        }, {\n          id: 3,\n          name: 'Climate Action March',\n          category: 'march',\n          date: '2026-04-22',\n          time: '11:00',\n          location: 'City Hall, New York',\n          ticketType: 'free',\n          price: 0,\n          description: 'Earth Day march demanding climate action. Bring your signs and your voice!',\n          organizer: 'FridaysForFuture',\n          rsvps: 156,\n          rsvped: false\n        }, {\n          id: 4,\n          name: 'Electronics Repair Café',\n          category: 'repair',\n          date: '2026-04-25',\n          time: '10:00',\n          location: 'MakerSpace Hub, Austin',\n          ticketType: 'free',\n          price: 0,\n          description: 'Bring your broken electronics and learn how to fix them. Expert volunteers on hand.',\n          organizer: 'RepairAustin',\n          rsvps: 19,\n          rsvped: false\n        }, {\n          id: 5,\n          name: 'Community Tree Planting',\n          category: 'planting',\n          date: '2026-05-01',\n          time: '08:30',\n          location: 'Riverside Park, Chicago',\n          ticketType: 'free',\n          price: 0,\n          description: 'Help us plant 200 native trees in Riverside Park. No experience needed!',\n          organizer: 'TreesForChi',\n          rsvps: 67,\n          rsvped: false\n        }, {\n          id: 6,\n          name: 'Sustainable Fashion Talk',\n          category: 'talk',\n          date: '2026-05-05',\n          time: '18:00',\n          location: 'Online (Zoom)',\n          ticketType: 'free',\n          price: 0,\n          description: 'Industry experts discuss the future of sustainable fashion and circular textiles.',\n          organizer: 'EcoFashionForum',\n          rsvps: 89,\n          rsvped: false\n        }];\n        this.saveEvents();\n      }\n    },\n    saveEvents() {\n      localStorage.setItem('susty_events', JSON.stringify(this.events));\n    }\n  }\n};","map":{"version":3,"names":["name","data","showCreateForm","viewMode","catFilter","events","newEvent","category","date","time","location","ticketType","price","description","eventCategories","id","icon","computed","currentUser","JSON","parse","localStorage","getItem","canCreate","trim","filteredEvents","now","Date","toISOString","split","result","filter","e","email","organizer","rsvped","sort","a","b","localeCompare","created","loadEvents","methods","getCatIcon","cat","find","c","getCatName","getCatColor","colors","cleanup","march","workshop","repair","planting","market","talk","formatMonth","dateStr","d","toLocaleString","month","toUpperCase","formatDay","getDate","createEvent","event","Number","rsvps","createdAt","push","saveEvents","rsvp","cancelRsvp","Math","max","saved","setItem","stringify"],"sources":["/home/rare/projects/susty/src/views/Events.vue"],"sourcesContent":["<template>\r\n  <div class=\"events\">\r\n    <!-- Header -->\r\n    <div class=\"events-header\">\r\n      <div>\r\n        <h1>📅 Sustainability Events</h1>\r\n        <p class=\"events-subtitle\">Discover and join events making a real-world impact.</p>\r\n      </div>\r\n      <button class=\"btn btn-primary btn-lg\" @click=\"showCreateForm = !showCreateForm\">\r\n        {{ showCreateForm ? '✕ Cancel' : '+ Create Event' }}\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Create Event Form -->\r\n    <div v-if=\"showCreateForm\" class=\"card event-form\">\r\n      <h3>Create a New Event</h3>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Event Name</label>\r\n          <input v-model=\"newEvent.name\" class=\"form-input\" placeholder=\"Give your event a name\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Category</label>\r\n          <select v-model=\"newEvent.category\" class=\"form-select\">\r\n            <option value=\"\">Select category</option>\r\n            <option v-for=\"cat in eventCategories\" :key=\"cat.id\" :value=\"cat.id\">{{ cat.icon }} {{ cat.name }}</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Date</label>\r\n          <input v-model=\"newEvent.date\" type=\"date\" class=\"form-input\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Time</label>\r\n          <input v-model=\"newEvent.time\" type=\"time\" class=\"form-input\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Location</label>\r\n          <input v-model=\"newEvent.location\" class=\"form-input\" placeholder=\"Where will it take place?\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Ticket Type</label>\r\n          <select v-model=\"newEvent.ticketType\" class=\"form-select\">\r\n            <option value=\"free\">Free</option>\r\n            <option value=\"paid\">Paid</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n      <div class=\"form-group\" v-if=\"newEvent.ticketType === 'paid'\">\r\n        <label class=\"form-label\">Ticket Price ($)</label>\r\n        <input v-model.number=\"newEvent.price\" type=\"number\" min=\"0\" step=\"0.01\" class=\"form-input\" />\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label class=\"form-label\">Description</label>\r\n        <textarea v-model=\"newEvent.description\" class=\"form-textarea\" placeholder=\"What's this event about? What should attendees expect?\"></textarea>\r\n      </div>\r\n      <div class=\"form-actions\">\r\n        <button class=\"btn btn-primary\" @click=\"createEvent\" :disabled=\"!canCreate\">Create Event</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Filters -->\r\n    <div class=\"tabs\">\r\n      <button class=\"tab\" :class=\"{ active: viewMode === 'upcoming' }\" @click=\"viewMode = 'upcoming'\">Upcoming</button>\r\n      <button class=\"tab\" :class=\"{ active: viewMode === 'past' }\" @click=\"viewMode = 'past'\">Past</button>\r\n      <button class=\"tab\" :class=\"{ active: viewMode === 'my' }\" @click=\"viewMode = 'my'\">My Events</button>\r\n    </div>\r\n\r\n    <div class=\"filter-chips\">\r\n      <button class=\"chip\" :class=\"{ active: catFilter === '' }\" @click=\"catFilter = ''\">All</button>\r\n      <button\r\n        v-for=\"cat in eventCategories\"\r\n        :key=\"cat.id\"\r\n        class=\"chip\"\r\n        :class=\"{ active: catFilter === cat.id }\"\r\n        @click=\"catFilter = cat.id\"\r\n      >{{ cat.icon }} {{ cat.name }}</button>\r\n    </div>\r\n\r\n    <!-- Events Grid -->\r\n    <div class=\"events-grid\">\r\n      <div v-if=\"filteredEvents.length === 0\" class=\"empty-state\" style=\"grid-column: 1/-1;\">\r\n        <div class=\"empty-state-icon\">📅</div>\r\n        <p>No events found. Be the first to create one!</p>\r\n      </div>\r\n\r\n      <div v-for=\"event in filteredEvents\" :key=\"event.id\" class=\"event-card card\">\r\n        <div class=\"event-date-badge\" :style=\"{ background: getCatColor(event.category) }\">\r\n          <span class=\"edb-month\">{{ formatMonth(event.date) }}</span>\r\n          <span class=\"edb-day\">{{ formatDay(event.date) }}</span>\r\n        </div>\r\n        <div class=\"event-body\">\r\n          <div class=\"event-cat-badge\">\r\n            <span class=\"badge badge-green\">{{ getCatIcon(event.category) }} {{ getCatName(event.category) }}</span>\r\n            <span v-if=\"event.ticketType === 'free'\" class=\"badge badge-blue\">Free</span>\r\n            <span v-else class=\"badge badge-orange\">${{ event.price }}</span>\r\n          </div>\r\n          <h3 class=\"event-name\">{{ event.name }}</h3>\r\n          <p class=\"event-desc\">{{ event.description }}</p>\r\n          <div class=\"event-meta\">\r\n            <span>📍 {{ event.location }}</span>\r\n            <span>🕐 {{ event.time }}</span>\r\n          </div>\r\n          <div class=\"event-footer\">\r\n            <div class=\"event-attendees\">\r\n              <span>👥 {{ event.rsvps || 0 }} attending</span>\r\n            </div>\r\n            <button\r\n              v-if=\"!event.rsvped\"\r\n              class=\"btn btn-primary btn-sm\"\r\n              @click=\"rsvp(event)\"\r\n            >RSVP</button>\r\n            <button\r\n              v-else\r\n              class=\"btn btn-outline btn-sm\"\r\n              @click=\"cancelRsvp(event)\"\r\n            >✓ Going</button>\r\n          </div>\r\n          <div class=\"event-organizer\">\r\n            <span class=\"organizer-label\">Organized by</span>\r\n            <strong>{{ event.organizer }}</strong>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'EventsView',\r\n  data() {\r\n    return {\r\n      showCreateForm: false,\r\n      viewMode: 'upcoming',\r\n      catFilter: '',\r\n      events: [],\r\n      newEvent: {\r\n        name: '',\r\n        category: '',\r\n        date: '',\r\n        time: '',\r\n        location: '',\r\n        ticketType: 'free',\r\n        price: 0,\r\n        description: ''\r\n      },\r\n      eventCategories: [\r\n        { id: 'cleanup', name: 'Cleanups', icon: '🧹' },\r\n        { id: 'march', name: 'Climate Marches', icon: '✊' },\r\n        { id: 'workshop', name: 'Workshops', icon: '🛠️' },\r\n        { id: 'repair', name: 'Repair Cafés', icon: '🔧' },\r\n        { id: 'planting', name: 'Tree Planting', icon: '🌳' },\r\n        { id: 'market', name: 'Eco Markets', icon: '🏪' },\r\n        { id: 'talk', name: 'Talks & Panels', icon: '🎤' }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    currentUser() {\r\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\r\n    },\r\n    canCreate() {\r\n      return this.newEvent.name.trim() && this.newEvent.category && this.newEvent.date && this.newEvent.location.trim()\r\n    },\r\n    filteredEvents() {\r\n      const now = new Date().toISOString().split('T')[0]\r\n      let result = [...this.events]\r\n      if (this.viewMode === 'upcoming') {\r\n        result = result.filter(e => e.date >= now)\r\n      } else if (this.viewMode === 'past') {\r\n        result = result.filter(e => e.date < now)\r\n      } else if (this.viewMode === 'my') {\r\n        const name = this.currentUser.name || this.currentUser.email || ''\r\n        result = result.filter(e => e.organizer === name || e.rsvped)\r\n      }\r\n      if (this.catFilter) {\r\n        result = result.filter(e => e.category === this.catFilter)\r\n      }\r\n      result.sort((a, b) => a.date.localeCompare(b.date))\r\n      return result\r\n    }\r\n  },\r\n  created() {\r\n    this.loadEvents()\r\n  },\r\n  methods: {\r\n    getCatIcon(id) {\r\n      const cat = this.eventCategories.find(c => c.id === id)\r\n      return cat ? cat.icon : '📅'\r\n    },\r\n    getCatName(id) {\r\n      const cat = this.eventCategories.find(c => c.id === id)\r\n      return cat ? cat.name : 'Event'\r\n    },\r\n    getCatColor(id) {\r\n      const colors = {\r\n        cleanup: 'linear-gradient(135deg, #4CAF50, #66BB6A)',\r\n        march: 'linear-gradient(135deg, #e53935, #ef5350)',\r\n        workshop: 'linear-gradient(135deg, #FF9800, #FFB74D)',\r\n        repair: 'linear-gradient(135deg, #795548, #a1887f)',\r\n        planting: 'linear-gradient(135deg, #2E7D32, #43A047)',\r\n        market: 'linear-gradient(135deg, #7B1FA2, #AB47BC)',\r\n        talk: 'linear-gradient(135deg, #1565C0, #42A5F5)'\r\n      }\r\n      return colors[id] || 'linear-gradient(135deg, #607D8B, #90A4AE)'\r\n    },\r\n    formatMonth(dateStr) {\r\n      if (!dateStr) return ''\r\n      const d = new Date(dateStr + 'T00:00:00')\r\n      return d.toLocaleString('en', { month: 'short' }).toUpperCase()\r\n    },\r\n    formatDay(dateStr) {\r\n      if (!dateStr) return ''\r\n      const d = new Date(dateStr + 'T00:00:00')\r\n      return d.getDate()\r\n    },\r\n    createEvent() {\r\n      if (!this.canCreate) return\r\n      const event = {\r\n        id: Date.now(),\r\n        name: this.newEvent.name.trim(),\r\n        category: this.newEvent.category,\r\n        date: this.newEvent.date,\r\n        time: this.newEvent.time || '10:00',\r\n        location: this.newEvent.location.trim(),\r\n        ticketType: this.newEvent.ticketType,\r\n        price: this.newEvent.ticketType === 'paid' ? Number(this.newEvent.price) || 0 : 0,\r\n        description: this.newEvent.description.trim(),\r\n        organizer: this.currentUser.name || this.currentUser.email || 'Anonymous',\r\n        rsvps: 0,\r\n        rsvped: false,\r\n        createdAt: new Date().toISOString()\r\n      }\r\n      this.events.push(event)\r\n      this.saveEvents()\r\n      this.showCreateForm = false\r\n      this.newEvent = { name: '', category: '', date: '', time: '', location: '', ticketType: 'free', price: 0, description: '' }\r\n    },\r\n    rsvp(event) {\r\n      event.rsvped = true\r\n      event.rsvps = (event.rsvps || 0) + 1\r\n      this.saveEvents()\r\n    },\r\n    cancelRsvp(event) {\r\n      event.rsvped = false\r\n      event.rsvps = Math.max(0, (event.rsvps || 1) - 1)\r\n      this.saveEvents()\r\n    },\r\n    loadEvents() {\r\n      const saved = localStorage.getItem('susty_events')\r\n      if (saved) {\r\n        this.events = JSON.parse(saved)\r\n      } else {\r\n        this.events = [\r\n          { id: 1, name: 'Beach Cleanup Day', category: 'cleanup', date: '2026-04-12', time: '09:00', location: 'Santa Monica Beach, CA', ticketType: 'free', price: 0, description: 'Join us for a community beach cleanup! Bring gloves and sunscreen. Trash bags provided.', organizer: 'OceanGuards', rsvps: 42, rsvped: false },\r\n          { id: 2, name: 'Zero Waste Workshop', category: 'workshop', date: '2026-04-18', time: '14:00', location: 'Green Community Center, Portland', ticketType: 'paid', price: 15, description: 'Learn practical tips to reduce household waste by 80%. Hands-on activities included.', organizer: 'ZeroWastePortland', rsvps: 28, rsvped: false },\r\n          { id: 3, name: 'Climate Action March', category: 'march', date: '2026-04-22', time: '11:00', location: 'City Hall, New York', ticketType: 'free', price: 0, description: 'Earth Day march demanding climate action. Bring your signs and your voice!', organizer: 'FridaysForFuture', rsvps: 156, rsvped: false },\r\n          { id: 4, name: 'Electronics Repair Café', category: 'repair', date: '2026-04-25', time: '10:00', location: 'MakerSpace Hub, Austin', ticketType: 'free', price: 0, description: 'Bring your broken electronics and learn how to fix them. Expert volunteers on hand.', organizer: 'RepairAustin', rsvps: 19, rsvped: false },\r\n          { id: 5, name: 'Community Tree Planting', category: 'planting', date: '2026-05-01', time: '08:30', location: 'Riverside Park, Chicago', ticketType: 'free', price: 0, description: 'Help us plant 200 native trees in Riverside Park. No experience needed!', organizer: 'TreesForChi', rsvps: 67, rsvped: false },\r\n          { id: 6, name: 'Sustainable Fashion Talk', category: 'talk', date: '2026-05-05', time: '18:00', location: 'Online (Zoom)', ticketType: 'free', price: 0, description: 'Industry experts discuss the future of sustainable fashion and circular textiles.', organizer: 'EcoFashionForum', rsvps: 89, rsvped: false }\r\n        ]\r\n        this.saveEvents()\r\n      }\r\n    },\r\n    saveEvents() {\r\n      localStorage.setItem('susty_events', JSON.stringify(this.events))\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.events-header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  margin-bottom: 1.5rem;\r\n}\r\n.events-header h1 { margin: 0 0 0.25rem; font-size: 1.8rem; }\r\n.events-subtitle { color: var(--muted-text); margin: 0; }\r\n\r\n.event-form { margin-bottom: 1.5rem; }\r\n.event-form h3 { margin-top: 0; }\r\n.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }\r\n.form-actions { display: 