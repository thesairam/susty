{"ast":null,"code":"export default {\n  name: 'DonationsView',\n  data() {\n    return {\n      showForm: false,\n      tab: 'available',\n      donations: [],\n      requests: [],\n      newDonation: {\n        name: '',\n        category: '',\n        condition: 'good',\n        location: '',\n        description: ''\n      },\n      newRequest: {\n        name: '',\n        location: ''\n      },\n      ngos: [{\n        id: 1,\n        name: 'Ocean Conservancy',\n        icon: '🌊',\n        description: 'Protecting the ocean from today\\'s greatest challenges.',\n        focus: ['Ocean', 'Wildlife'],\n        supporters: 1240,\n        impact: '500K lbs trash removed'\n      }, {\n        id: 2,\n        name: 'Trees for the Future',\n        icon: '🌳',\n        description: 'Planting trees to restore degraded lands and fight poverty.',\n        focus: ['Reforestation', 'Agriculture'],\n        supporters: 890,\n        impact: '250M trees planted'\n      }, {\n        id: 3,\n        name: 'Zero Waste Alliance',\n        icon: '♻️',\n        description: 'Advancing zero waste strategies for communities and businesses.',\n        focus: ['Zero Waste', 'Education'],\n        supporters: 650,\n        impact: '1M tons waste diverted'\n      }, {\n        id: 4,\n        name: 'Clean Air Fund',\n        icon: '💨',\n        description: 'Tackling air pollution through philanthropy, data, and advocacy.',\n        focus: ['Air Quality', 'Health'],\n        supporters: 430,\n        impact: '50 cities improved'\n      }, {\n        id: 5,\n        name: 'Repair Café International',\n        icon: '🔧',\n        description: 'Growing the global network of free repair events.',\n        focus: ['Repair', 'Community'],\n        supporters: 780,\n        impact: '2,500+ cafés worldwide'\n      }, {\n        id: 6,\n        name: 'Greenpeace',\n        icon: '🌍',\n        description: 'Campaigning for a green and peaceful future.',\n        focus: ['Climate', 'Activism'],\n        supporters: 3200,\n        impact: 'Global campaigns'\n      }]\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User';\n    },\n    canDonate() {\n      return this.newDonation.name.trim() && this.newDonation.category && this.newDonation.description.trim();\n    },\n    filteredDonations() {\n      return this.donations.filter(d => !d.claimed);\n    },\n    totalDonated() {\n      return this.donations.length;\n    },\n    totalClaimed() {\n      return this.donations.filter(d => d.claimed).length;\n    },\n    totalRequests() {\n      return this.requests.length;\n    },\n    co2Saved() {\n      return (this.donations.length * 5).toFixed(1);\n    }\n  },\n  created() {\n    this.loadDonations();\n    this.loadRequests();\n  },\n  methods: {\n    getCatIcon(cat) {\n      const icons = {\n        clothing: '👕',\n        furniture: '🪑',\n        electronics: '📱',\n        books: '📚',\n        kitchen: '🍳',\n        toys: '🧸',\n        other: '📦'\n      };\n      return icons[cat] || '📦';\n    },\n    getCatColor(cat) {\n      const colors = {\n        clothing: 'linear-gradient(135deg, #CE93D8, #AB47BC)',\n        furniture: 'linear-gradient(135deg, #A5D6A7, #66BB6A)',\n        electronics: 'linear-gradient(135deg, #90CAF9, #42A5F5)',\n        books: 'linear-gradient(135deg, #B39DDB, #7E57C2)',\n        kitchen: 'linear-gradient(135deg, #EF9A9A, #EF5350)',\n        toys: 'linear-gradient(135deg, #FFE082, #FFD54F)',\n        other: 'linear-gradient(135deg, #E0E0E0, #BDBDBD)'\n      };\n      return colors[cat] || colors.other;\n    },\n    timeAgo(dateStr) {\n      const diff = Math.floor((Date.now() - new Date(dateStr)) / 1000);\n      if (diff < 60) return 'just now';\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';\n      return Math.floor(diff / 86400) + 'd ago';\n    },\n    createDonation() {\n      if (!this.canDonate) return;\n      const donation = {\n        id: Date.now(),\n        name: this.newDonation.name.trim(),\n        category: this.newDonation.category,\n        condition: this.newDonation.condition,\n        location: this.newDonation.location.trim(),\n        description: this.newDonation.description.trim(),\n        donor: this.currentUserName,\n        claimed: false,\n        date: new Date().toISOString()\n      };\n      this.donations.unshift(donation);\n      this.saveDonations();\n      this.showForm = false;\n      this.newDonation = {\n        name: '',\n        category: '',\n        condition: 'good',\n        location: '',\n        description: ''\n      };\n    },\n    claimItem(item) {\n      item.claimed = true;\n      item.claimedBy = this.currentUserName;\n      this.saveDonations();\n    },\n    createRequest() {\n      if (!this.newRequest.name.trim()) return;\n      this.requests.unshift({\n        id: Date.now(),\n        name: this.newRequest.name.trim(),\n        location: this.newRequest.location.trim(),\n        requester: this.currentUserName,\n        fulfilled: false,\n        date: new Date().toISOString()\n      });\n      this.saveRequests();\n      this.newRequest = {\n        name: '',\n        location: ''\n      };\n    },\n    fulfillRequest(req) {\n      req.fulfilled = true;\n      this.saveRequests();\n    },\n    supportNgo(ngo) {\n      ngo.supporters++;\n    },\n    loadDonations() {\n      const saved = localStorage.getItem('susty_donations');\n      if (saved) {\n        this.donations = JSON.parse(saved);\n      } else {\n        this.donations = [{\n          id: 1,\n          name: 'Winter Jacket (Size M)',\n          category: 'clothing',\n          condition: 'Good',\n          location: 'Portland, OR',\n          description: 'Warm winter jacket, barely worn. Great condition.',\n          donor: 'EcoWarrior',\n          claimed: false,\n          date: '2026-03-28T09:00:00Z'\n        }, {\n          id: 2,\n          name: 'Children\\'s Book Collection',\n          category: 'books',\n          condition: 'Like New',\n          location: 'Austin, TX',\n          description: 'Set of 15 children\\'s books, ages 5-10. Great stories!',\n          donor: 'BookLover',\n          claimed: false,\n          date: '2026-03-27T14:00:00Z'\n        }, {\n          id: 3,\n          name: 'Old Laptop (Working)',\n          category: 'electronics',\n          condition: 'Fair',\n          location: 'Seattle, WA',\n          description: 'Dell laptop, a bit slow but works fine for basic tasks.',\n          donor: 'TechHelper',\n          claimed: false,\n          date: '2026-03-25T11:00:00Z'\n        }, {\n          id: 4,\n          name: 'Kitchen Utensil Set',\n          category: 'kitchen',\n          condition: 'Good',\n          location: 'Denver, CO',\n          description: 'Full set of wooden kitchen utensils. Eco-friendly!',\n          donor: 'GreenChef',\n          claimed: true,\n          date: '2026-03-20T10:00:00Z'\n        }];\n        this.saveDonations();\n      }\n    },\n    loadRequests() {\n      const saved = localStorage.getItem('susty_requests');\n      if (saved) {\n        this.requests = JSON.parse(saved);\n      } else {\n        this.requests = [{\n          id: 1,\n          name: 'Baby stroller',\n          location: 'Chicago, IL',\n          requester: 'NewParent',\n          fulfilled: false,\n          date: '2026-03-29T08:00:00Z'\n        }, {\n          id: 2,\n          name: 'Sewing machine',\n          location: 'Portland, OR',\n          requester: 'CraftyCarl',\n          fulfilled: false,\n          date: '2026-03-28T12:00:00Z'\n        }];\n        this.saveRequests();\n      }\n    },\n    saveDonations() {\n      localStorage.setItem('susty_donations', JSON.stringify(this.donations));\n    },\n    saveRequests() {\n      localStorage.setItem('susty_requests', JSON.stringify(this.requests));\n    }\n  }\n};","map":{"version":3,"names":["name","data","showForm","tab","donations","requests","newDonation","category","condition","location","description","newRequest","ngos","id","icon","focus","supporters","impact","computed","currentUser","JSON","parse","localStorage","getItem","currentUserName","email","canDonate","trim","filteredDonations","filter","d","claimed","totalDonated","length","totalClaimed","totalRequests","co2Saved","toFixed","created","loadDonations","loadRequests","methods","getCatIcon","cat","icons","clothing","furniture","electronics","books","kitchen","toys","other","getCatColor","colors","timeAgo","dateStr","diff","Math","floor","Date","now","createDonation","donation","donor","date","toISOString","unshift","saveDonations","claimItem","item","claimedBy","createRequest","requester","fulfilled","saveRequests","fulfillRequest","req","supportNgo","ngo","saved","setItem","stringify"],"sources":["/home/rare/projects/susty/src/views/Donations.vue"],"sourcesContent":["<template>\r\n  <div class=\"donations\">\r\n    <div class=\"donations-header\">\r\n      <div>\r\n        <h1>🎁 Donations & Giving</h1>\r\n        <p class=\"donations-subtitle\">Give away items for free, request what you need, or support sustainability NGOs.</p>\r\n      </div>\r\n      <button class=\"btn btn-primary btn-lg\" @click=\"showForm = !showForm\">\r\n        {{ showForm ? '✕ Cancel' : '+ Donate an Item' }}\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Create Donation Form -->\r\n    <div v-if=\"showForm\" class=\"card donation-form\">\r\n      <h3>Donate an Item</h3>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Item Name</label>\r\n          <input v-model=\"newDonation.name\" class=\"form-input\" placeholder=\"What are you giving away?\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Category</label>\r\n          <select v-model=\"newDonation.category\" class=\"form-select\">\r\n            <option value=\"\">Select category</option>\r\n            <option value=\"clothing\">👕 Clothing</option>\r\n            <option value=\"furniture\">🪑 Furniture</option>\r\n            <option value=\"electronics\">📱 Electronics</option>\r\n            <option value=\"books\">📚 Books</option>\r\n            <option value=\"kitchen\">🍳 Kitchen</option>\r\n            <option value=\"toys\">🧸 Toys</option>\r\n            <option value=\"other\">📦 Other</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Condition</label>\r\n          <select v-model=\"newDonation.condition\" class=\"form-select\">\r\n            <option value=\"new\">New</option>\r\n            <option value=\"like-new\">Like New</option>\r\n            <option value=\"good\">Good</option>\r\n            <option value=\"fair\">Fair</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Location / Pickup</label>\r\n          <input v-model=\"newDonation.location\" class=\"form-input\" placeholder=\"Where can it be picked up?\" />\r\n        </div>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label class=\"form-label\">Description</label>\r\n        <textarea v-model=\"newDonation.description\" class=\"form-textarea\" placeholder=\"Describe the item...\"></textarea>\r\n      </div>\r\n      <div class=\"form-actions\">\r\n        <button class=\"btn btn-primary\" @click=\"createDonation\" :disabled=\"!canDonate\">Publish Donation</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Tabs -->\r\n    <div class=\"tabs\">\r\n      <button class=\"tab\" :class=\"{ active: tab === 'available' }\" @click=\"tab = 'available'\">Available Items</button>\r\n      <button class=\"tab\" :class=\"{ active: tab === 'requests' }\" @click=\"tab = 'requests'\">Requests</button>\r\n      <button class=\"tab\" :class=\"{ active: tab === 'ngos' }\" @click=\"tab = 'ngos'\">Support NGOs</button>\r\n    </div>\r\n\r\n    <!-- Available Donations -->\r\n    <div v-if=\"tab === 'available'\" class=\"donations-grid\">\r\n      <div v-if=\"filteredDonations.length === 0\" class=\"empty-state\" style=\"grid-column: 1/-1;\">\r\n        <div class=\"empty-state-icon\">🎁</div>\r\n        <p>No items available right now. Be the first to donate!</p>\r\n      </div>\r\n      <div v-for=\"item in filteredDonations\" :key=\"item.id\" class=\"donation-card card\">\r\n        <div class=\"donation-image\" :style=\"{ background: getCatColor(item.category) }\">\r\n          <span>{{ getCatIcon(item.category) }}</span>\r\n        </div>\r\n        <div class=\"donation-info\">\r\n          <h3>{{ item.name }}</h3>\r\n          <p class=\"donation-desc\">{{ item.description }}</p>\r\n          <div class=\"donation-meta\">\r\n            <span class=\"badge badge-green\">{{ item.condition }}</span>\r\n            <span>📍 {{ item.location }}</span>\r\n          </div>\r\n          <div class=\"donation-footer\">\r\n            <div class=\"donation-donor\">\r\n              <div class=\"avatar avatar-sm\">{{ item.donor.charAt(0).toUpperCase() }}</div>\r\n              <span>{{ item.donor }}</span>\r\n            </div>\r\n            <button\r\n              v-if=\"!item.claimed\"\r\n              class=\"btn btn-primary btn-sm\"\r\n              @click=\"claimItem(item)\"\r\n            >Claim Item</button>\r\n            <span v-else class=\"claimed-badge badge badge-blue\">Claimed</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Requests -->\r\n    <div v-if=\"tab === 'requests'\" class=\"requests-section\">\r\n      <div class=\"card request-form-inline\">\r\n        <h3>Request an Item</h3>\r\n        <div class=\"request-form-row\">\r\n          <input v-model=\"newRequest.name\" class=\"form-input\" placeholder=\"What do you need?\" />\r\n          <input v-model=\"newRequest.location\" class=\"form-input\" placeholder=\"Your location\" />\r\n          <button class=\"btn btn-primary\" @click=\"createRequest\" :disabled=\"!newRequest.name.trim()\">Post Request</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"requests-list\">\r\n        <div v-if=\"requests.length === 0\" class=\"empty-state\">\r\n          <div class=\"empty-state-icon\">🙋</div>\r\n          <p>No requests yet. Need something? Post a request above!</p>\r\n        </div>\r\n        <div v-for=\"req in requests\" :key=\"req.id\" class=\"request-card card\">\r\n          <div class=\"request-header\">\r\n            <div class=\"avatar avatar-sm\">{{ req.requester.charAt(0).toUpperCase() }}</div>\r\n            <div>\r\n              <strong>{{ req.requester }}</strong>\r\n              <span class=\"request-time\">{{ timeAgo(req.date) }}</span>\r\n            </div>\r\n          </div>\r\n          <p class=\"request-content\">Looking for: <strong>{{ req.name }}</strong></p>\r\n          <span class=\"request-location\" v-if=\"req.location\">📍 {{ req.location }}</span>\r\n          <button\r\n            v-if=\"!req.fulfilled\"\r\n            class=\"btn btn-outline btn-sm\"\r\n            @click=\"fulfillRequest(req)\"\r\n          >I Have This!</button>\r\n          <span v-else class=\"badge badge-green\">✅ Fulfilled</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- NGOs -->\r\n    <div v-if=\"tab === 'ngos'\" class=\"ngos-grid\">\r\n      <div v-for=\"ngo in ngos\" :key=\"ngo.id\" class=\"ngo-card card\">\r\n        <div class=\"ngo-icon\">{{ ngo.icon }}</div>\r\n        <h3>{{ ngo.name }}</h3>\r\n        <p class=\"ngo-desc\">{{ ngo.description }}</p>\r\n        <div class=\"ngo-focus\">\r\n          <span class=\"badge badge-green\" v-for=\"focus in ngo.focus\" :key=\"focus\">{{ focus }}</span>\r\n        </div>\r\n        <div class=\"ngo-stats\">\r\n          <span>👥 {{ ngo.supporters }} supporters</span>\r\n          <span>🌍 {{ ngo.impact }}</span>\r\n        </div>\r\n        <button class=\"btn btn-primary btn-sm\" @click=\"supportNgo(ngo)\">Support</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Impact Summary -->\r\n    <section class=\"donations-impact card\">\r\n      <h3>🌍 Community Donation Impact</h3>\r\n      <div class=\"impact-stats\">\r\n        <div class=\"impact-stat\">\r\n          <span class=\"stat-value\">{{ totalDonated }}</span>\r\n          <span class=\"stat-label\">Items Donated</span>\r\n        </div>\r\n        <div class=\"impact-stat\">\r\n          <span class=\"stat-value\">{{ totalClaimed }}</span>\r\n          <span class=\"stat-label\">Items Claimed</span>\r\n        </div>\r\n        <div class=\"impact-stat\">\r\n          <span class=\"stat-value\">{{ totalRequests }}</span>\r\n          <span class=\"stat-label\">Requests Made</span>\r\n        </div>\r\n        <div class=\"impact-stat\">\r\n          <span class=\"stat-value\">{{ co2Saved }}</span>\r\n          <span class=\"stat-label\">kg CO₂ Saved</span>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'DonationsView',\r\n  data() {\r\n    return {\r\n      showForm: false,\r\n      tab: 'available',\r\n      donations: [],\r\n      requests: [],\r\n      newDonation: {\r\n        name: '',\r\n        category: '',\r\n        condition: 'good',\r\n        location: '',\r\n        description: ''\r\n      },\r\n      newRequest: { name: '', location: '' },\r\n      ngos: [\r\n        { id: 1, name: 'Ocean Conservancy', icon: '🌊', description: 'Protecting the ocean from today\\'s greatest challenges.', focus: ['Ocean', 'Wildlife'], supporters: 1240, impact: '500K lbs trash removed' },\r\n        { id: 2, name: 'Trees for the Future', icon: '🌳', description: 'Planting trees to restore degraded lands and fight poverty.', focus: ['Reforestation', 'Agriculture'], supporters: 890, impact: '250M trees planted' },\r\n        { id: 3, name: 'Zero Waste Alliance', icon: '♻️', description: 'Advancing zero waste strategies for communities and businesses.', focus: ['Zero Waste', 'Education'], supporters: 650, impact: '1M tons waste diverted' },\r\n        { id: 4, name: 'Clean Air Fund', icon: '💨', description: 'Tackling air pollution through philanthropy, data, and advocacy.', focus: ['Air Quality', 'Health'], supporters: 430, impact: '50 cities improved' },\r\n        { id: 5, name: 'Repair Café International', icon: '🔧', description: 'Growing the global network of free repair events.', focus: ['Repair', 'Community'], supporters: 780, impact: '2,500+ cafés worldwide' },\r\n        { id: 6, name: 'Greenpeace', icon: '🌍', description: 'Campaigning for a green and peaceful future.', focus: ['Climate', 'Activism'], supporters: 3200, impact: 'Global campaigns' }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    currentUser() {\r\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\r\n    },\r\n    currentUserName() {\r\n      return this.currentUser.name || this.currentUser.email || 'User'\r\n    },\r\n    canDonate() {\r\n      return this.newDonation.name.trim() && this.newDonation.category && this.newDonation.description.trim()\r\n    },\r\n    filteredDonations() {\r\n      return this.donations.filter(d => !d.claimed)\r\n    },\r\n    totalDonated() { return this.donations.length },\r\n    totalClaimed() { return this.donations.filter(d => d.claimed).length },\r\n    totalRequests() { return this.requests.length },\r\n    co2Saved() { return (this.donations.length * 5).toFixed(1) }\r\n  },\r\n  created() {\r\n    this.loadDonations()\r\n    this.loadRequests()\r\n  },\r\n  methods: {\r\n    getCatIcon(cat) {\r\n      const icons = { clothing: '👕', furniture: '🪑', electronics: '📱', books: '📚', kitchen: '🍳', toys: '🧸', other: '📦' }\r\n      return icons[cat] || '📦'\r\n    },\r\n    getCatColor(cat) {\r\n      const colors = {\r\n        clothing: 'linear-gradient(135deg, #CE93D8, #AB47BC)',\r\n        furniture: 'linear-gradient(135deg, #A5D6A7, #66BB6A)',\r\n        electronics: 'linear-gradient(135deg, #90CAF9, #42A5F5)',\r\n        books: 'linear-gradient(135deg, #B39DDB, #7E57C2)',\r\n        kitchen: 'linear-gradient(135deg, #EF9A9A, #EF5350)',\r\n        toys: 'linear-gradient(135deg, #FFE082, #FFD54F)',\r\n        other: 'linear-gradient(135deg, #E0E0E0, #BDBDBD)'\r\n      }\r\n      return colors[cat] || colors.other\r\n    },\r\n    timeAgo(dateStr) {\r\n      const diff = Math.floor((Date.now() - new Date(dateStr)) / 1000)\r\n      if (diff < 60) return 'just now'\r\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago'\r\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago'\r\n      return Math.floor(diff / 86400) + 'd ago'\r\n    },\r\n    createDonation() {\r\n      if (!this.canDonate) return\r\n      const donation = {\r\n        id: Date.now(),\r\n        name: this.newDonation.name.trim(),\r\n        category: this.newDonation.category,\r\n        condition: this.newDonation.condition,\r\n        location: this.newDonation.location.trim(),\r\n        description: this.newDonation.description.trim(),\r\n        donor: this.currentUserName,\r\n        claimed: false,\r\n        date: new Date().toISOString()\r\n      }\r\n      this.donations.unshift(donation)\r\n      this.saveDonations()\r\n      this.showForm = false\r\n      this.newDonation = { name: '', category: '', condition: 'good', location: '', description: '' }\r\n    },\r\n    claimItem(item) {\r\n      item.claimed = true\r\n      item.claimedBy = this.currentUserName\r\n      this.saveDonations()\r\n    },\r\n    createRequest() {\r\n      if (!this.newRequest.name.trim()) return\r\n      this.requests.unshift({\r\n        id: Date.now(),\r\n        name: this.newRequest.name.trim(),\r\n        location: this.newRequest.location.trim(),\r\n        requester: this.currentUserName,\r\n        fulfilled: false,\r\n        date: new Date().toISOString()\r\n      })\r\n      this.saveRequests()\r\n      this.newRequest = { name: '', location: '' }\r\n    },\r\n    fulfillRequest(req) {\r\n      req.fulfilled = true\r\n      this.saveRequests()\r\n    },\r\n    supportNgo(ngo) {\r\n      ngo.supporters++\r\n    },\r\n    loadDonations() {\r\n      const saved = localStorage.getItem('susty_donations')\r\n      if (saved) {\r\n        this.donations = JSON.parse(saved)\r\n      } else {\r\n        this.donations = [\r\n          { id: 1, name: 'Winter Jacket (Size M)', category: 'clothing', condition: 'Good', location: 'Portland, OR', description: 'Warm winter jacket, barely worn. Great condition.', donor: 'EcoWarrior', claimed: false, date: '2026-03-28T09:00:00Z' },\r\n          { id: 2, name: 'Children\\'s Book Collection', category: 'books', condition: 'Like New', location: 'Austin, TX', description: 'Set of 15 children\\'s books, ages 5-10. Great stories!', donor: 'BookLover', claimed: false, date: '2026-03-27T14:00:00Z' },\r\n          { id: 3, name: 'Old Laptop (Working)', category: 'electronics', condition: 'Fair', location: 'Seattle, WA', description: 'Dell laptop, a bit slow but works fine for basic tasks.', donor: 'TechHelper', claimed: false, date: '2026-03-25T11:00:00Z' },\r\n          { id: 4, name: 'Kitchen Utensil Set', category: 'kitchen', condition: 'Good', location: 'Denver, CO', description: 'Full set of wooden kitchen utensils. Eco-friendly!', donor: 'GreenChef', claimed: true, date: '2026-03-20T10:00:00Z' }\r\n        ]\r\n        this.saveDonations()\r\n      }\r\n    },\r\n    loadRequests() {\r\n      const saved = localStorage.getItem('susty_requests')\r\n      if (saved) {\r\n        this.requests = JSON.parse(saved)\r\n      } else {\r\n        thi