{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'MessagesView',\n  data() {\n    return {\n      messages: [],\n      searchQuery: '',\n      activeConversation: null,\n      newMessage: ''\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User';\n    },\n    conversations() {\n      const convos = {};\n      this.messages.forEach(msg => {\n        const other = msg.from === this.currentUserName ? msg.to : msg.from;\n        if (!convos[other] || new Date(msg.date) > new Date(convos[other].lastDate)) {\n          convos[other] = {\n            participant: other,\n            lastMessage: msg.content,\n            lastDate: msg.date,\n            unread: msg.to === this.currentUserName && !msg.read\n          };\n        }\n      });\n      return Object.values(convos).sort((a, b) => new Date(b.lastDate) - new Date(a.lastDate));\n    },\n    filteredConversations() {\n      if (!this.searchQuery.trim()) return this.conversations;\n      const q = this.searchQuery.toLowerCase();\n      return this.conversations.filter(c => c.participant.toLowerCase().includes(q) || c.lastMessage.toLowerCase().includes(q));\n    },\n    activeMessages() {\n      if (!this.activeConversation) return [];\n      return this.messages.filter(msg => msg.from === this.currentUserName && msg.to === this.activeConversation || msg.from === this.activeConversation && msg.to === this.currentUserName).sort((a, b) => new Date(a.date) - new Date(b.date));\n    }\n  },\n  created() {\n    this.loadMessages();\n  },\n  methods: {\n    selectConversation(participant) {\n      this.activeConversation = participant;\n      this.messages.forEach(msg => {\n        if (msg.from === participant && msg.to === this.currentUserName) {\n          msg.read = true;\n        }\n      });\n      this.saveMessages();\n      this.$nextTick(() => this.scrollToBottom());\n    },\n    sendMessage() {\n      if (!this.newMessage.trim() || !this.activeConversation) return;\n      this.messages.push({\n        id: Date.now(),\n        from: this.currentUserName,\n        to: this.activeConversation,\n        content: this.newMessage.trim(),\n        date: new Date().toISOString(),\n        read: false\n      });\n      this.newMessage = '';\n      this.saveMessages();\n      this.$nextTick(() => this.scrollToBottom());\n    },\n    scrollToBottom() {\n      const el = this.$refs.chatMessages;\n      if (el) el.scrollTop = el.scrollHeight;\n    },\n    timeAgo(dateStr) {\n      const diff = Math.floor((new Date() - new Date(dateStr)) / 1000);\n      if (diff < 60) return 'now';\n      if (diff < 3600) return Math.floor(diff / 60) + 'm';\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h';\n      return Math.floor(diff / 86400) + 'd';\n    },\n    formatTime(dateStr) {\n      return new Date(dateStr).toLocaleTimeString([], {\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    },\n    loadMessages() {\n      const saved = localStorage.getItem('susty_messages');\n      if (saved) {\n        this.messages = JSON.parse(saved);\n      } else {\n        this.messages = [{\n          id: 1,\n          from: 'EcoWarrior',\n          to: this.currentUserName,\n          content: 'Hey! The water bottle is still available. Interested?',\n          date: '2026-03-30T10:30:00Z',\n          read: false\n        }, {\n          id: 2,\n          from: this.currentUserName,\n          to: 'EcoWarrior',\n          content: 'Yes! Can we meet in downtown Portland?',\n          date: '2026-03-30T10:35:00Z',\n          read: true\n        }, {\n          id: 3,\n          from: 'EcoWarrior',\n          to: this.currentUserName,\n          content: 'Sure! How about Saturday at 2pm near the park?',\n          date: '2026-03-30T10:40:00Z',\n          read: false\n        }, {\n          id: 4,\n          from: 'MakerMike',\n          to: this.currentUserName,\n          content: 'Would you trade the Arduino kit for some gardening tools?',\n          date: '2026-03-29T15:00:00Z',\n          read: false\n        }];\n        this.saveMessages();\n      }\n    },\n    saveMessages() {\n      localStorage.setItem('susty_messages', JSON.stringify(this.messages));\n    }\n  }\n};","map":{"version":3,"names":["name","data","messages","searchQuery","activeConversation","newMessage","computed","currentUser","JSON","parse","localStorage","getItem","currentUserName","email","conversations","convos","forEach","msg","other","from","to","Date","date","lastDate","participant","lastMessage","content","unread","read","Object","values","sort","a","b","filteredConversations","trim","q","toLowerCase","filter","c","includes","activeMessages","created","loadMessages","methods","selectConversation","saveMessages","$nextTick","scrollToBottom","sendMessage","push","id","now","toISOString","el","$refs","chatMessages","scrollTop","scrollHeight","timeAgo","dateStr","diff","Math","floor","formatTime","toLocaleTimeString","hour","minute","saved","setItem","stringify"],"sources":["/home/rare/projects/susty/src/views/Messages.vue"],"sourcesContent":["<template>\r\n  <div class=\"messages\">\r\n    <h1>💬 Messages</h1>\r\n\r\n    <div class=\"messages-layout\">\r\n      <!-- Conversations List -->\r\n      <div class=\"conversations card\">\r\n        <div class=\"conversations-header\">\r\n          <input v-model=\"searchQuery\" class=\"form-input\" placeholder=\"🔍 Search conversations...\" />\r\n        </div>\r\n        <div class=\"conversations-list\">\r\n          <div v-if=\"filteredConversations.length === 0\" class=\"empty-state\">\r\n            <p>No conversations yet. Start one from the Marketplace!</p>\r\n          </div>\r\n          <div\r\n            v-for=\"convo in filteredConversations\"\r\n            :key=\"convo.participant\"\r\n            class=\"convo-item\"\r\n            :class=\"{ active: activeConversation === convo.participant }\"\r\n            @click=\"selectConversation(convo.participant)\"\r\n          >\r\n            <div class=\"avatar\">{{ convo.participant.charAt(0).toUpperCase() }}</div>\r\n            <div class=\"convo-info\">\r\n              <div class=\"convo-top\">\r\n                <strong>{{ convo.participant }}</strong>\r\n                <span class=\"convo-time\">{{ timeAgo(convo.lastDate) }}</span>\r\n              </div>\r\n              <p class=\"convo-preview\">{{ convo.lastMessage }}</p>\r\n            </div>\r\n            <span v-if=\"convo.unread\" class=\"unread-dot\"></span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Chat Area -->\r\n      <div class=\"chat-area card\">\r\n        <div v-if=\"!activeConversation\" class=\"empty-state\">\r\n          <div class=\"empty-state-icon\">💬</div>\r\n          <p>Select a conversation to start chatting</p>\r\n        </div>\r\n\r\n        <template v-else>\r\n          <div class=\"chat-header\">\r\n            <div class=\"avatar\">{{ activeConversation.charAt(0).toUpperCase() }}</div>\r\n            <strong>{{ activeConversation }}</strong>\r\n          </div>\r\n\r\n          <div class=\"chat-messages\" ref=\"chatMessages\">\r\n            <div\r\n              v-for=\"msg in activeMessages\"\r\n              :key=\"msg.id\"\r\n              class=\"message\"\r\n              :class=\"{ sent: msg.from === currentUserName, received: msg.from !== currentUserName }\"\r\n            >\r\n              <div class=\"message-bubble\">\r\n                <p>{{ msg.content }}</p>\r\n                <span class=\"message-time\">{{ formatTime(msg.date) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <div class=\"chat-input\">\r\n            <input\r\n              v-model=\"newMessage\"\r\n              class=\"form-input\"\r\n              placeholder=\"Type a message...\"\r\n              @keyup.enter=\"sendMessage\"\r\n            />\r\n            <button class=\"btn btn-primary\" @click=\"sendMessage\" :disabled=\"!newMessage.trim()\">Send</button>\r\n          </div>\r\n        </template>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'MessagesView',\r\n  data() {\r\n    return {\r\n      messages: [],\r\n      searchQuery: '',\r\n      activeConversation: null,\r\n      newMessage: ''\r\n    }\r\n  },\r\n  computed: {\r\n    currentUser() {\r\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\r\n    },\r\n    currentUserName() {\r\n      return this.currentUser.name || this.currentUser.email || 'User'\r\n    },\r\n    conversations() {\r\n      const convos = {}\r\n      this.messages.forEach(msg => {\r\n        const other = msg.from === this.currentUserName ? msg.to : msg.from\r\n        if (!convos[other] || new Date(msg.date) > new Date(convos[other].lastDate)) {\r\n          convos[other] = {\r\n            participant: other,\r\n            lastMessage: msg.content,\r\n            lastDate: msg.date,\r\n            unread: msg.to === this.currentUserName && !msg.read\r\n          }\r\n        }\r\n      })\r\n      return Object.values(convos).sort((a, b) => new Date(b.lastDate) - new Date(a.lastDate))\r\n    },\r\n    filteredConversations() {\r\n      if (!this.searchQuery.trim()) return this.conversations\r\n      const q = this.searchQuery.toLowerCase()\r\n      return this.conversations.filter(c =>\r\n        c.participant.toLowerCase().includes(q) ||\r\n        c.lastMessage.toLowerCase().includes(q)\r\n      )\r\n    },\r\n    activeMessages() {\r\n      if (!this.activeConversation) return []\r\n      return this.messages\r\n        .filter(msg =>\r\n          (msg.from === this.currentUserName && msg.to === this.activeConversation) ||\r\n          (msg.from === this.activeConversation && msg.to === this.currentUserName)\r\n        )\r\n        .sort((a, b) => new Date(a.date) - new Date(b.date))\r\n    }\r\n  },\r\n  created() {\r\n    this.loadMessages()\r\n  },\r\n  methods: {\r\n    selectConversation(participant) {\r\n      this.activeConversation = participant\r\n      this.messages.forEach(msg => {\r\n        if (msg.from === participant && msg.to === this.currentUserName) {\r\n          msg.read = true\r\n        }\r\n      })\r\n      this.saveMessages()\r\n      this.$nextTick(() => this.scrollToBottom())\r\n    },\r\n    sendMessage() {\r\n      if (!this.newMessage.trim() || !this.activeConversation) return\r\n      this.messages.push({\r\n        id: Date.now(),\r\n        from: this.currentUserName,\r\n        to: this.activeConversation,\r\n        content: this.newMessage.trim(),\r\n        date: new Date().toISOString(),\r\n        read: false\r\n      })\r\n      this.newMessage = ''\r\n      this.saveMessages()\r\n      this.$nextTick(() => this.scrollToBottom())\r\n    },\r\n    scrollToBottom() {\r\n      const el = this.$refs.chatMessages\r\n      if (el) el.scrollTop = el.scrollHeight\r\n    },\r\n    timeAgo(dateStr) {\r\n      const diff = Math.floor((new Date() - new Date(dateStr)) / 1000)\r\n      if (diff < 60) return 'now'\r\n      if (diff < 3600) return Math.floor(diff / 60) + 'm'\r\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h'\r\n      return Math.floor(diff / 86400) + 'd'\r\n    },\r\n    formatTime(dateStr) {\r\n      return new Date(dateStr).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\r\n    },\r\n    loadMessages() {\r\n      const saved = localStorage.getItem('susty_messages')\r\n      if (saved) {\r\n        this.messages = JSON.parse(saved)\r\n      } else {\r\n        this.messages = [\r\n          { id: 1, from: 'EcoWarrior', to: this.currentUserName, content: 'Hey! The water bottle is still available. Interested?', date: '2026-03-30T10:30:00Z', read: false },\r\n          { id: 2, from: this.currentUserName, to: 'EcoWarrior', content: 'Yes! Can we meet in downtown Portland?', date: '2026-03-30T10:35:00Z', read: true },\r\n          { id: 3, from: 'EcoWarrior', to: this.currentUserName, content: 'Sure! How about Saturday at 2pm near the park?', date: '2026-03-30T10:40:00Z', read: false },\r\n          { id: 4, from: 'MakerMike', to: this.currentUserName, content: 'Would you trade the Arduino kit for some gardening tools?', date: '2026-03-29T15:00:00Z', read: false }\r\n        ]\r\n        this.saveMessages()\r\n      }\r\n    },\r\n    saveMessages() {\r\n      localStorage.setItem('susty_messages', JSON.stringify(this.messages))\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\nh1 { margin: 0 0 1.5rem; font-size: 1.8rem; }\r\n\r\n.messages-layout {\r\n  display: grid;\r\n  grid-template-columns: 320px 1fr;\r\n  gap: 1.25rem;\r\n  height: calc(100vh - 220px);\r\n  min-height: 500px;\r\n}\r\n\r\n.conversations {\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n.conversations-header { padding-bottom: 0.75rem; }\r\n.conversations-list { flex: 1; overflow-y: auto; margin: 0 -1.5rem; padding: 0; }\r\n\r\n.convo-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  padding: 0.85rem 1.5rem;\r\n  cursor: pointer;\r\n  transition: background var(--transition);\r\n  position: relative;\r\n}\r\n.convo-item:hover { background: var(--light-bg); }\r\n.convo-item.active { background: var(--light-green); }\r\n.convo-info { flex: 1; min-width: 0; }\r\n.convo-top { display: flex; justify-content: space-between; align-items: center; }\r\n.convo-time { font-size: 0.75rem; color: var(--muted-text); }\r\n.convo-preview {\r\n  margin: 0.15rem 0 0;\r\n  font-size: 0.8rem;\r\n  color: var(--muted-text);\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n.unread-dot {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background: var(--primary-green);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.chat-area {\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow: hidden;\r\n}\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  padding-bottom: 0.75rem;\r\n  border-bottom: 1px solid var(--border-color);\r\n  margin-bottom: 0.75rem;\r\n}\r\n.chat-messages {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 0.5rem 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.5rem;\r\n}\r\n\r\n.message { display: flex; }\r\n.message.sent { justify-content: flex-end; }\r\n.message.received { justify-content: flex-start; }\r\n.message-bubble {\r\n  max-width: 70%;\r\n  padding: 0.65rem 0.95rem;\r\n  border-radius: 16px;\r\n  font-size: 0.9rem;\r\n  line-height: 1.4;\r\n}\r\n.message-bubble p { margin: 0; }\r\n.message.sent .message-bubble {\r\n  background: var(--primary-green);\r\n  color: white;\r\n  border-bottom-right-radius: 4px;\r\n}\r\n.message.received .message-bubble {\r\n  background: #f0f0f0;\r\n  color: var(--dark-text);\r\n  border-bottom-left-radius: 4px;\r\n}\r\n.message-time {\r\n  display: block;\r\n  font-size: 0.65rem;\r\n  opacity: 0.7;\r\n  margin-top: 0.25rem;\r\n  text-align: right;\r\n}\r\n\r\n.chat-input {\r\n  display: flex;\r\n  gap: 0.5rem;\r\n  padding-top: 0.75rem;\r\n  border-top: 1px solid var(--border-color);\r\n  margin-top: 0.75rem;\r\n}\r\n.chat-input .form-input { flex: 1; }\r\n\r\n@media (max-width: 768px) {\r\n  .messages-layout {\r\n    grid-template-columns: 1fr;\r\n    height: auto;\r\n  }\r\n  .conversations { max-height: 300px; }\r\n}\r\n</style>\r\n"],"mappings":";AA6EA,eAAe;EACbA,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,WAAW,EAAE,EAAE;MACfC,kBAAkB,EAAE,IAAI;MACxBC,UAAU,EAAE;IACd;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,IAAI;QAAE,OAAOC,IAAI,CAACC,KAAK,CAACC,YAAY,CAACC,OAAO,CAAC,aAAa,CAAC,KAAK,CAAC;MAAE,EAAE,MAAM;QAAE,OAAO,CAAC;MAAE;IACzF,CAAC