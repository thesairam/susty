{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'CommunityView',\n  data() {\n    return {\n      communityPosts: [],\n      expandedPosts: [],\n      commentInputs: {},\n      newPost: {\n        title: '',\n        content: ''\n      },\n      groups: [{\n        id: 1,\n        name: 'Portland Eco-Living',\n        icon: '🌲',\n        color: 'linear-gradient(135deg, #4CAF50, #66BB6A)',\n        location: 'Portland, OR',\n        description: 'Sustainable living in the Pacific Northwest',\n        members: 342,\n        joined: false\n      }, {\n        id: 2,\n        name: 'Austin Zero Waste',\n        icon: '♻️',\n        color: 'linear-gradient(135deg, #FF9800, #FFB74D)',\n        location: 'Austin, TX',\n        description: 'Working towards a zero-waste Austin',\n        members: 218,\n        joined: false\n      }, {\n        id: 3,\n        name: 'NYC Climate Action',\n        icon: '🌍',\n        color: 'linear-gradient(135deg, #2196F3, #64B5F6)',\n        location: 'New York, NY',\n        description: 'Climate activism in the Big Apple',\n        members: 567,\n        joined: false\n      }, {\n        id: 4,\n        name: 'Bay Area Garden Club',\n        icon: '🌻',\n        color: 'linear-gradient(135deg, #8BC34A, #AED581)',\n        location: 'San Francisco, CA',\n        description: 'Urban gardening and composting community',\n        members: 189,\n        joined: false\n      }],\n      trendingTopics: ['ZeroWaste', 'CircularEconomy', 'PlantBased', 'RepairCulture', 'LocalFood', 'CleanEnergy'],\n      activeMembers: ['EcoWarrior', 'GreenGuru', 'SolarSteve', 'ZeroWasteZoe', 'TreeHugger']\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User';\n    }\n  },\n  created() {\n    this.loadPosts();\n  },\n  methods: {\n    timeAgo(dateStr) {\n      const diff = Math.floor((new Date() - new Date(dateStr)) / 1000);\n      if (diff < 60) return 'just now';\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago';\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago';\n      return Math.floor(diff / 86400) + 'd ago';\n    },\n    submitPost() {\n      if (!this.newPost.title.trim() || !this.newPost.content.trim()) return;\n      const post = {\n        id: Date.now(),\n        title: this.newPost.title.trim(),\n        content: this.newPost.content.trim(),\n        author: this.currentUserName,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        comments: []\n      };\n      this.communityPosts.unshift(post);\n      this.savePosts();\n      this.newPost = {\n        title: '',\n        content: ''\n      };\n    },\n    toggleLike(post) {\n      post.liked = !post.liked;\n      post.likes = (post.likes || 0) + (post.liked ? 1 : -1);\n      this.savePosts();\n    },\n    toggleComments(postId) {\n      const idx = this.expandedPosts.indexOf(postId);\n      if (idx >= 0) this.expandedPosts.splice(idx, 1);else this.expandedPosts.push(postId);\n    },\n    addComment(post) {\n      const text = (this.commentInputs[post.id] || '').trim();\n      if (!text) return;\n      if (!post.comments) post.comments = [];\n      post.comments.push({\n        id: Date.now(),\n        author: this.currentUserName,\n        content: text,\n        date: new Date().toISOString()\n      });\n      this.commentInputs[post.id] = '';\n      this.savePosts();\n    },\n    deletePost(postId) {\n      this.communityPosts = this.communityPosts.filter(p => p.id !== postId);\n      this.savePosts();\n    },\n    joinGroup(group) {\n      group.joined = true;\n      group.members++;\n    },\n    loadPosts() {\n      const saved = localStorage.getItem('susty_community_posts');\n      if (saved) {\n        this.communityPosts = JSON.parse(saved);\n      } else {\n        this.communityPosts = [{\n          id: 1,\n          title: 'Tips for Reducing Plastic Waste',\n          content: 'I\\'ve managed to cut my plastic waste by 80% this year! Here are my top strategies: bring reusable bags everywhere, switch to bar soap and shampoo, use beeswax wraps instead of cling film, and shop at bulk stores.',\n          author: 'EcoWarrior',\n          date: '2026-03-29T10:00:00Z',\n          likes: 24,\n          liked: false,\n          comments: [{\n            id: 101,\n            author: 'GreenGuru',\n            content: 'Great tips! I\\'d add: bring your own containers to restaurants for leftovers.',\n            date: '2026-03-29T11:30:00Z'\n          }]\n        }, {\n          id: 2,\n          title: 'Community Garden Initiative',\n          content: 'I\\'m starting a community garden in our neighborhood. Looking for 10 volunteers to help set up raised beds and choose what to plant. We have space for ~20 plots. Who wants to join?',\n          author: 'GreenThumb',\n          date: '2026-03-28T14:00:00Z',\n          likes: 18,\n          liked: false,\n          comments: []\n        }, {\n          id: 3,\n          title: 'Local Farmer\\'s Market Report',\n          content: 'Visited the Saturday market and found amazing locally-grown produce. The prices were cheaper than the supermarket AND everything was organic!',\n          author: 'LocalFoodie',\n          date: '2026-03-27T09:00:00Z',\n          likes: 12,\n          liked: false,\n          comments: []\n        }];\n        this.savePosts();\n      }\n    },\n    savePosts() {\n      localStorage.setItem('susty_community_posts', JSON.stringify(this.communityPosts));\n    }\n  }\n};","map":{"version":3,"names":["name","data","communityPosts","expandedPosts","commentInputs","newPost","title","content","groups","id","icon","color","location","description","members","joined","trendingTopics","activeMembers","computed","currentUser","JSON","parse","localStorage","getItem","currentUserName","email","created","loadPosts","methods","timeAgo","dateStr","diff","Math","floor","Date","submitPost","trim","post","now","author","date","toISOString","likes","liked","comments","unshift","savePosts","toggleLike","toggleComments","postId","idx","indexOf","splice","push","addComment","text","deletePost","filter","p","joinGroup","group","saved","setItem","stringify"],"sources":["/home/rare/projects/susty/src/views/Community.vue"],"sourcesContent":["<template>\n  <div class=\"community\">\n    <div class=\"community-header\">\n      <div>\n        <h1>👥 Local Communities</h1>\n        <p class=\"community-subtitle\">Connect with sustainability-minded people in your area.</p>\n      </div>\n    </div>\n\n    <!-- Local Groups -->\n    <section class=\"groups-section\">\n      <h2 class=\"section-title\">📍 Local Groups</h2>\n      <div class=\"groups-grid\">\n        <div v-for=\"group in groups\" :key=\"group.id\" class=\"group-card card\">\n          <div class=\"group-icon\" :style=\"{ background: group.color }\">{{ group.icon }}</div>\n          <div class=\"group-info\">\n            <h3>{{ group.name }}</h3>\n            <p class=\"group-location\">📍 {{ group.location }}</p>\n            <p class=\"group-desc\">{{ group.description }}</p>\n            <div class=\"group-footer\">\n              <span>👥 {{ group.members }} members</span>\n              <button\n                v-if=\"!group.joined\"\n                class=\"btn btn-outline btn-sm\"\n                @click=\"joinGroup(group)\"\n              >Join</button>\n              <span v-else class=\"badge badge-green\">✅ Joined</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Community Feed -->\n    <div class=\"community-layout\">\n      <div class=\"community-feed\">\n        <h2 class=\"section-title\">💬 Community Discussion</h2>\n\n        <div v-if=\"communityPosts.length === 0\" class=\"empty-state\">\n          <div class=\"empty-state-icon\">💬</div>\n          <p>No posts yet. Start a discussion!</p>\n        </div>\n\n        <div v-for=\"post in communityPosts\" :key=\"post.id\" class=\"post-card card\">\n          <div class=\"post-header\">\n            <div class=\"avatar\">{{ post.author.charAt(0).toUpperCase() }}</div>\n            <div class=\"post-meta-info\">\n              <strong>{{ post.author }}</strong>\n              <span class=\"post-time\">{{ timeAgo(post.date) }}</span>\n            </div>\n            <button v-if=\"post.author === currentUserName\" class=\"icon-btn\" @click=\"deletePost(post.id)\">🗑️</button>\n          </div>\n          <h3 class=\"post-title\">{{ post.title }}</h3>\n          <p class=\"post-content\">{{ post.content }}</p>\n          <div class=\"post-actions\">\n            <button class=\"action-btn\" :class=\"{ liked: post.liked }\" @click=\"toggleLike(post)\">\n              {{ post.liked ? '❤️' : '🤍' }} {{ post.likes || 0 }}\n            </button>\n            <button class=\"action-btn\" @click=\"toggleComments(post.id)\">\n              💬 {{ (post.comments || []).length }}\n            </button>\n          </div>\n          <div v-if=\"expandedPosts.includes(post.id)\" class=\"comments-section\">\n            <div v-for=\"comment in (post.comments || [])\" :key=\"comment.id\" class=\"comment\">\n              <div class=\"avatar avatar-sm\">{{ comment.author.charAt(0).toUpperCase() }}</div>\n              <div>\n                <strong>{{ comment.author }}</strong>\n                <p>{{ comment.content }}</p>\n              </div>\n            </div>\n            <div class=\"comment-compose\">\n              <input\n                v-model=\"commentInputs[post.id]\"\n                class=\"form-input\"\n                placeholder=\"Add a comment...\"\n                @keyup.enter=\"addComment(post)\"\n              />\n              <button class=\"btn btn-sm btn-primary\" @click=\"addComment(post)\">Post</button>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- Sidebar -->\n      <div class=\"community-sidebar\">\n        <div class=\"card post-form-card\">\n          <h3>Start a Discussion</h3>\n          <div class=\"form-group\">\n            <input v-model=\"newPost.title\" class=\"form-input\" placeholder=\"Discussion title\" />\n          </div>\n          <div class=\"form-group\">\n            <textarea v-model=\"newPost.content\" class=\"form-textarea\" placeholder=\"Share your thoughts...\" rows=\"4\"></textarea>\n          </div>\n          <button @click=\"submitPost\" class=\"btn btn-primary\" style=\"width: 100%\" :disabled=\"!newPost.title.trim() || !newPost.content.trim()\">Post</button>\n        </div>\n\n        <!-- Trending Topics -->\n        <div class=\"card trending-card\">\n          <h3>🔥 Trending Topics</h3>\n          <div class=\"trending-list\">\n            <div v-for=\"topic in trendingTopics\" :key=\"topic\" class=\"trending-item\">\n              <span class=\"hashtag\">#{{ topic }}</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- Active Members -->\n        <div class=\"card active-members-card\">\n          <h3>⭐ Active Members</h3>\n          <div class=\"members-list\">\n            <div v-for=\"member in activeMembers\" :key=\"member\" class=\"member-item\">\n              <div class=\"avatar avatar-sm\">{{ member.charAt(0).toUpperCase() }}</div>\n              <span>{{ member }}</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'CommunityView',\n  data() {\n    return {\n      communityPosts: [],\n      expandedPosts: [],\n      commentInputs: {},\n      newPost: { title: '', content: '' },\n      groups: [\n        { id: 1, name: 'Portland Eco-Living', icon: '🌲', color: 'linear-gradient(135deg, #4CAF50, #66BB6A)', location: 'Portland, OR', description: 'Sustainable living in the Pacific Northwest', members: 342, joined: false },\n        { id: 2, name: 'Austin Zero Waste', icon: '♻️', color: 'linear-gradient(135deg, #FF9800, #FFB74D)', location: 'Austin, TX', description: 'Working towards a zero-waste Austin', members: 218, joined: false },\n        { id: 3, name: 'NYC Climate Action', icon: '🌍', color: 'linear-gradient(135deg, #2196F3, #64B5F6)', location: 'New York, NY', description: 'Climate activism in the Big Apple', members: 567, joined: false },\n        { id: 4, name: 'Bay Area Garden Club', icon: '🌻', color: 'linear-gradient(135deg, #8BC34A, #AED581)', location: 'San Francisco, CA', description: 'Urban gardening and composting community', members: 189, joined: false }\n      ],\n      trendingTopics: ['ZeroWaste', 'CircularEconomy', 'PlantBased', 'RepairCulture', 'LocalFood', 'CleanEnergy'],\n      activeMembers: ['EcoWarrior', 'GreenGuru', 'SolarSteve', 'ZeroWasteZoe', 'TreeHugger']\n    }\n  },\n  computed: {\n    currentUser() {\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User'\n    }\n  },\n  created() {\n    this.loadPosts()\n  },\n  methods: {\n    timeAgo(dateStr) {\n      const diff = Math.floor((new Date() - new Date(dateStr)) / 1000)\n      if (diff < 60) return 'just now'\n      if (diff < 3600) return Math.floor(diff / 60) + 'm ago'\n      if (diff < 86400) return Math.floor(diff / 3600) + 'h ago'\n      return Math.floor(diff / 86400) + 'd ago'\n    },\n    submitPost() {\n      if (!this.newPost.title.trim() || !this.newPost.content.trim()) return\n      const post = {\n        id: Date.now(),\n        title: this.newPost.title.trim(),\n        content: this.newPost.content.trim(),\n        author: this.currentUserName,\n        date: new Date().toISOString(),\n        likes: 0,\n        liked: false,\n        comments: []\n      }\n      this.communityPosts.unshift(post)\n      this.savePosts()\n      this.newPost = { title: '', content: '' }\n    },\n    toggleLike(post) {\n      post.liked = !post.liked\n      post.likes = (post.likes || 0) + (post.liked ? 1 : -1)\n      this.savePosts()\n    },\n    toggleComments(postId) {\n      const idx = this.expandedPosts.indexOf(postId)\n      if (idx >= 0) this.expandedPosts.splice(idx, 1)\n      else this.expandedPosts.push(postId)\n    },\n    addComment(post) {\n      const text = (this.commentInputs[post.id] || '').trim()\n      if (!text) return\n      if (!post.comments) post.comments = []\n      post.comments.push({\n        id: Date.now(),\n        author: this.currentUserName,\n        content: text,\n        date: new Date().toISOString()\n      })\n      this.commentInputs[post.id] = ''\n      this.savePosts()\n    },\n    deletePost(postId) {\n      this.communityPosts = this.communityPosts.filter(p => p.id !== postId)\n      this.savePosts()\n    },\n    joinGroup(group) {\n      group.joined = true\n      group.members++\n    },\n    loadPosts() {\n      const saved = localStorage.getItem('susty_community_posts')\n      if (saved) {\n        this.communityPosts = JSON.parse(saved)\n      } else {\n        this.communityPosts = [\n          { id: 1, title: 'Tips for Reducing Plastic Waste', content: 'I\\'ve managed to cut my plastic waste by 80% this year! Here are my top strategies: bring reusable bags everywhere, switch to bar soap and shampoo, use beeswax wraps instead of cling film, and shop at bulk stores.', author: 'EcoWarrior', date: '2026-03-29T10:00:00Z', likes: 24, liked: false, comments: [{ id: 101, author: 'GreenGuru', content: 'Great tips! I\\'d add: bring your own containers to restaurants for leftovers.', date: '2026-03-29T11:30:00Z' }] },\n          { id: 2, title: 'Community Garden Initiative', content: 'I\\'m starting a community garden in our neighborhood. Looking for 10 volunteers to help set up raised beds and choose what to plant. We have space for ~20 plots. Who wants to join?', author: 'GreenThumb', date: '2026-03-28T14:00:00Z', likes: 18, liked: false, comments: [] },\n          { id: 3, title: 'Local Farmer\\'s Market Report', content: 'Visited the Saturday market and found amazing locally-grown produce. The prices were cheaper than the supermarket AND everything was organic!', author: 'LocalFoodie', date: '2026-03-27T09:00:00Z', likes: 12, liked: false, comments: [] }\n        ]\n        this.savePosts()\n      }\n    },\n    savePosts() {\n      localStorage.setItem('susty_community_posts', JSON.stringify(this.communityPosts))\n    }\n  }\n}\n</script>\n\n<style scoped>\n.community-header { margin-bottom: 1.5rem; }\n.community-header h1 { margin: 0 0 0.25rem; font-size: 1.8rem; }\n.community-subtitle { color: var(--muted-text); margin: 0; }\n\n.groups-section { margin-bottom: 2rem; }\n.groups-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1rem;\n}\n.group-card { display: flex; gap: 1rem; align-items: flex-start; }\n.group-icon {\n  width: 50px;\n  height: 50px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.5rem;\n  flex-shrink: 0;\n}\n.group-info { flex: 1; }\n.group-info h3 { margin: 0 0 0.15rem; font-size: 0.95rem; }\n.group-location { font-size: 0.8rem; color: var(--muted-text); margin: 0 0 0.25rem; }\n.group-desc { font-size: 0.85rem; color: var(--muted-text); margin: 0 0 0.5rem; }\n.group-footer { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--muted-text); }\n\n.community-layout {\n  display: grid;\n  grid-template-columns: 1fr 320px;\n  gap: 1.5rem;\n  align-items: start;\n}\n\n.post-card { margin-bottom: 1rem; }\n.post-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; }\n.post-meta-info { flex: 1; }\n.post-meta-info strong { display: block; font-size: 0.9rem; }\n.post-time { font-size: 0.8rem; color: var(--muted-text); }\n.icon-btn { background: none; border: none; cursor: pointer; padding: 0.25rem 0.5rem; border-radius: var(--radius-sm); }\n.icon-btn:hover { background: #f0f0f0; }\n.post-title { margin: 0 0 0.35rem; font-size: 1.05rem; }\n.post-content { color: var(--dark-text); margin: 0 0 0.75rem; line-height: 1.5; }\n\n.post-actions { display: flex; gap: 0.5rem; padding-top: 0.5rem; border-top: 1px solid var(--border-color); }\n.action-btn {\n  background: none; border: none; padding: 0.35rem 0.65rem; border-radius: var(--radius-sm);\n  cursor: pointer; font-size: 0.85rem; color: var(--muted-text); transition: all var(--transition);\n}\n.action-btn:hover { background: var(--light-bg); }\n.action-btn.liked { color: #e74c3c; }\n\n.comments-section { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid var(--border-color); }\n.comment {\n  display: flex; gap: 0.5rem; align-items: flex-start;\n  padding: 0.5rem; background: var(--light-bg); border-radius: var(--radius-sm); margin-bottom: 0.5rem;\n}\n.comment p { margin: 0.15rem 0 0; font-size: 0.85rem; }\n.comment strong { font-size: 0.85rem; }\n.comment-compose { display: flex; gap: 0.5rem; margin-top: 0.5rem; }\n.comment-compose .form-input { flex: 1; }\n\n/* Sidebar */\n.post-form-card h3, .trending-card h3, .active-members-card h3 { margin-top: 0; font-size: 1rem; }\n.community-sidebar .card { margin-bottom: 1rem; }\n.trending-list { display: flex; flex-direction: column; gap: 0.35rem; }\n.trending-item { padding: 0.25rem 0; }\n.members-list { display: flex; flex-direction: column; gap: 0.5rem; }\n.member-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem; }\n\n@media (max-width: 900px) {\n  .community-layout { grid-template-columns: 1fr; }\n  .community-sidebar { order: -1; }\n  .groups-grid { grid-template-columns: 1fr; }\n}\n</style>"],"mappings":";AA0HA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,cAAc,EAAE,EAAE;MAClBC,aAAa,EAAE,E