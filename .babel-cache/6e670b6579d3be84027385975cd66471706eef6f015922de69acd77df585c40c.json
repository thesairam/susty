{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'MarketplaceView',\n  data() {\n    return {\n      showListingForm: false,\n      searchQuery: '',\n      activeCategory: '',\n      typeFilter: '',\n      sortBy: 'newest',\n      newListing: {\n        name: '',\n        price: 0,\n        category: '',\n        condition: 'good',\n        type: 'sell',\n        location: '',\n        description: ''\n      },\n      categories: [{\n        id: 'furniture',\n        name: 'Furniture',\n        icon: '🪑'\n      }, {\n        id: 'electronics',\n        name: 'Electronics',\n        icon: '📱'\n      }, {\n        id: 'clothing',\n        name: 'Clothing',\n        icon: '👕'\n      }, {\n        id: 'diy',\n        name: 'DIY Materials',\n        icon: '🔧'\n      }, {\n        id: 'garden',\n        name: 'Garden',\n        icon: '🌱'\n      }, {\n        id: 'kitchen',\n        name: 'Kitchen',\n        icon: '🍳'\n      }, {\n        id: 'books',\n        name: 'Books',\n        icon: '📚'\n      }, {\n        id: 'sports',\n        name: 'Sports',\n        icon: '⚽'\n      }],\n      listings: []\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    canCreateListing() {\n      return this.newListing.name.trim() && this.newListing.category && this.newListing.description.trim();\n    },\n    filteredListings() {\n      let result = [...this.listings];\n      if (this.searchQuery) {\n        const q = this.searchQuery.toLowerCase();\n        result = result.filter(l => l.name.toLowerCase().includes(q) || l.description.toLowerCase().includes(q) || (l.location || '').toLowerCase().includes(q));\n      }\n      if (this.activeCategory) {\n        result = result.filter(l => l.category === this.activeCategory);\n      }\n      if (this.typeFilter) {\n        result = result.filter(l => l.type === this.typeFilter);\n      }\n      switch (this.sortBy) {\n        case 'price-low':\n          result.sort((a, b) => a.price - b.price);\n          break;\n        case 'price-high':\n          result.sort((a, b) => b.price - a.price);\n          break;\n        case 'rating':\n          result.sort((a, b) => (b.rating || 0) - (a.rating || 0));\n          break;\n        default:\n          result.sort((a, b) => b.id - a.id);\n      }\n      return result;\n    }\n  },\n  created() {\n    this.loadListings();\n  },\n  methods: {\n    getCategoryIcon(catId) {\n      const cat = this.categories.find(c => c.id === catId);\n      return cat ? cat.icon : '📦';\n    },\n    getCategoryColor(catId) {\n      const colors = {\n        furniture: 'linear-gradient(135deg, #a8d8a8, #6bb86b)',\n        electronics: 'linear-gradient(135deg, #90caf9, #42a5f5)',\n        clothing: 'linear-gradient(135deg, #ce93d8, #ab47bc)',\n        diy: 'linear-gradient(135deg, #ffcc80, #ffa726)',\n        garden: 'linear-gradient(135deg, #a5d6a7, #66bb6a)',\n        kitchen: 'linear-gradient(135deg, #ef9a9a, #ef5350)',\n        books: 'linear-gradient(135deg, #b39ddb, #7e57c2)',\n        sports: 'linear-gradient(135deg, #80deea, #26c6da)'\n      };\n      return colors[catId] || 'linear-gradient(135deg, #e0e0e0, #bdbdbd)';\n    },\n    conditionLabel(cond) {\n      const labels = {\n        'new': 'New',\n        'like-new': 'Like New',\n        'good': 'Good',\n        'fair': 'Fair'\n      };\n      return labels[cond] || cond;\n    },\n    createListing() {\n      if (!this.canCreateListing) return;\n      const carbonMap = {\n        furniture: 25,\n        electronics: 15,\n        clothing: 8,\n        diy: 10,\n        garden: 5,\n        kitchen: 6,\n        books: 3,\n        sports: 7\n      };\n      const listing = {\n        id: Date.now(),\n        name: this.newListing.name.trim(),\n        price: this.newListing.type === 'free' ? 0 : Number(this.newListing.price) || 0,\n        category: this.newListing.category,\n        condition: this.newListing.condition,\n        conditionLabel: this.conditionLabel(this.newListing.condition),\n        type: this.newListing.type,\n        location: this.newListing.location.trim(),\n        description: this.newListing.description.trim(),\n        seller: this.currentUser.name || this.currentUser.email || 'Anonymous',\n        rating: null,\n        carbonSaved: carbonMap[this.newListing.category] || 5,\n        favorited: false,\n        date: new Date().toISOString()\n      };\n      this.listings.unshift(listing);\n      this.saveListings();\n      this.showListingForm = false;\n      this.newListing = {\n        name: '',\n        price: 0,\n        category: '',\n        condition: 'good',\n        type: 'sell',\n        location: '',\n        description: ''\n      };\n    },\n    toggleFavorite(listing) {\n      listing.favorited = !listing.favorited;\n      this.saveListings();\n    },\n    contactSeller(listing) {\n      const messages = JSON.parse(localStorage.getItem('susty_messages') || '[]');\n      messages.push({\n        id: Date.now(),\n        from: this.currentUser.name || this.currentUser.email || 'User',\n        to: listing.seller,\n        content: `Hi! I'm interested in your listing: \"${listing.name}\"`,\n        date: new Date().toISOString(),\n        read: false\n      });\n      localStorage.setItem('susty_messages', JSON.stringify(messages));\n    },\n    loadListings() {\n      const saved = localStorage.getItem('susty_listings');\n      if (saved) {\n        this.listings = JSON.parse(saved);\n      } else {\n        this.listings = [{\n          id: 1,\n          name: 'Eco-friendly Water Bottle',\n          description: 'Reusable stainless steel bottle, 750ml. Used for 2 months.',\n          price: 19.99,\n          category: 'kitchen',\n          condition: 'like-new',\n          conditionLabel: 'Like New',\n          type: 'sell',\n          location: 'Portland, OR',\n          seller: 'EcoWarrior',\n          rating: 4.8,\n          carbonSaved: 6,\n          favorited: false,\n          date: '2026-03-28T10:00:00Z'\n        }, {\n          id: 2,\n          name: 'Solar Power Bank',\n          description: 'Charge your devices anywhere with solar energy. 20000mAh capacity.',\n          price: 39.99,\n          category: 'electronics',\n          condition: 'new',\n          conditionLabel: 'New',\n          type: 'sell',\n          location: 'Austin, TX',\n          seller: 'SolarSteve',\n          rating: 4.5,\n          carbonSaved: 15,\n          favorited: false,\n          date: '2026-03-27T14:00:00Z'\n        }, {\n          id: 3,\n          name: 'Bamboo Toothbrush Set',\n          description: 'Set of 4 biodegradable bamboo toothbrushes. Never opened.',\n          price: 12.99,\n          category: 'kitchen',\n          condition: 'new',\n          conditionLabel: 'New',\n          type: 'sell',\n          location: 'Seattle, WA',\n          seller: 'GreenGuru',\n          rating: 4.9,\n          carbonSaved: 3,\n          favorited: false,\n          date: '2026-03-26T09:00:00Z'\n        }, {\n          id: 4,\n          name: 'Vintage Wooden Desk',\n          description: 'Solid oak desk from the 1970s. A few scratches but structurally perfect.',\n          price: 85.00,\n          category: 'furniture',\n          condition: 'good',\n          conditionLabel: 'Good',\n          type: 'sell',\n          location: 'Denver, CO',\n          seller: 'RetroRick',\n          rating: 4.2,\n          carbonSaved: 25,\n          favorited: false,\n          date: '2026-03-25T16:00:00Z'\n        }, {\n          id: 5,\n          name: 'Kids Clothing Bundle',\n          description: '10 pieces of gently used kids clothing, ages 4-6. Mixed brands.',\n          price: 0,\n          category: 'clothing',\n          condition: 'good',\n          conditionLabel: 'Good',\n          type: 'free',\n          location: 'Chicago, IL',\n          seller: 'MomOfThree',\n          rating: 5.0,\n          carbonSaved: 8,\n          favorited: false,\n          date: '2026-03-24T11:00:00Z'\n        }, {\n          id: 6,\n          name: 'Arduino Starter Kit',\n          description: 'Complete kit with sensors, LEDs, wires. Great for DIY projects.',\n          price: 25.00,\n          category: 'diy',\n          condition: 'like-new',\n          conditionLabel: 'Like New',\n          type: 'trade',\n          location: 'San Francisco, CA',\n          seller: 'MakerMike',\n          rating: 4.7,\n          carbonSaved: 10,\n          favorited: false,\n          date: '2026-03-23T08:00:00Z'\n        }];\n        this.saveListings();\n      }\n    },\n    saveListings() {\n      localStorage.setItem('susty_listings', JSON.stringify(this.listings));\n    }\n  }\n};","map":{"version":3,"names":["name","data","showListingForm","searchQuery","activeCategory","typeFilter","sortBy","newListing","price","category","condition","type","location","description","categories","id","icon","listings","computed","currentUser","JSON","parse","localStorage","getItem","canCreateListing","trim","filteredListings","result","q","toLowerCase","filter","l","includes","sort","a","b","rating","created","loadListings","methods","getCategoryIcon","catId","cat","find","c","getCategoryColor","colors","furniture","electronics","clothing","diy","garden","kitchen","books","sports","conditionLabel","cond","labels","createListing","carbonMap","listing","Date","now","Number","seller","email","carbonSaved","favorited","date","toISOString","unshift","saveListings","toggleFavorite","contactSeller","messages","push","from","to","content","read","setItem","stringify","saved"],"sources":["/home/rare/projects/susty/src/views/Marketplace.vue"],"sourcesContent":["<template>\n  <div class=\"marketplace\">\n    <!-- Marketplace Header -->\n    <div class=\"mp-header\">\n      <div>\n        <h1>🛒 Sustainability Marketplace</h1>\n        <p class=\"mp-subtitle\">Buy, sell, trade — give items a second life and reduce waste.</p>\n      </div>\n      <button class=\"btn btn-primary btn-lg\" @click=\"showListingForm = !showListingForm\">\n        {{ showListingForm ? '✕ Cancel' : '+ List an Item' }}\n      </button>\n    </div>\n\n    <!-- New Listing Form -->\n    <div v-if=\"showListingForm\" class=\"card listing-form\">\n      <h3>Create a Listing</h3>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label class=\"form-label\">Item Name</label>\n          <input v-model=\"newListing.name\" class=\"form-input\" placeholder=\"What are you selling?\" />\n        </div>\n        <div class=\"form-group\">\n          <label class=\"form-label\">Price ($)</label>\n          <input v-model.number=\"newListing.price\" type=\"number\" min=\"0\" step=\"0.01\" class=\"form-input\" placeholder=\"0.00\" />\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label class=\"form-label\">Category</label>\n          <select v-model=\"newListing.category\" class=\"form-select\">\n            <option value=\"\">Select category</option>\n            <option v-for=\"cat in categories\" :key=\"cat.id\" :value=\"cat.id\">{{ cat.icon }} {{ cat.name }}</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label class=\"form-label\">Condition</label>\n          <select v-model=\"newListing.condition\" class=\"form-select\">\n            <option value=\"new\">New</option>\n            <option value=\"like-new\">Like New</option>\n            <option value=\"good\">Good</option>\n            <option value=\"fair\">Fair</option>\n          </select>\n        </div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"form-group\">\n          <label class=\"form-label\">Listing Type</label>\n          <select v-model=\"newListing.type\" class=\"form-select\">\n            <option value=\"sell\">Sell</option>\n            <option value=\"trade\">Trade</option>\n            <option value=\"free\">Give Away Free</option>\n          </select>\n        </div>\n        <div class=\"form-group\">\n          <label class=\"form-label\">Location</label>\n          <input v-model=\"newListing.location\" class=\"form-input\" placeholder=\"City or neighborhood\" />\n        </div>\n      </div>\n      <div class=\"form-group\">\n        <label class=\"form-label\">Description</label>\n        <textarea v-model=\"newListing.description\" class=\"form-textarea\" placeholder=\"Describe the item, its condition, and why you're listing it...\"></textarea>\n      </div>\n      <div class=\"form-actions\">\n        <button class=\"btn btn-primary\" @click=\"createListing\" :disabled=\"!canCreateListing\">Publish Listing</button>\n      </div>\n    </div>\n\n    <!-- Search & Filter Bar -->\n    <div class=\"filter-bar card\">\n      <input v-model=\"searchQuery\" class=\"form-input search-input\" placeholder=\"🔍 Search marketplace...\" />\n      <div class=\"filter-chips\">\n        <button\n          class=\"chip\"\n          :class=\"{ active: activeCategory === '' }\"\n          @click=\"activeCategory = ''\"\n        >All</button>\n        <button\n          v-for=\"cat in categories\"\n          :key=\"cat.id\"\n          class=\"chip\"\n          :class=\"{ active: activeCategory === cat.id }\"\n          @click=\"activeCategory = cat.id\"\n        >{{ cat.icon }} {{ cat.name }}</button>\n      </div>\n      <div class=\"filter-row\">\n        <select v-model=\"sortBy\" class=\"form-select sort-select\">\n          <option value=\"newest\">Newest First</option>\n          <option value=\"price-low\">Price: Low to High</option>\n          <option value=\"price-high\">Price: High to Low</option>\n          <option value=\"rating\">Top Rated</option>\n        </select>\n        <div class=\"filter-chips-sm\">\n          <button class=\"chip chip-sm\" :class=\"{ active: typeFilter === '' }\" @click=\"typeFilter = ''\">All Types</button>\n          <button class=\"chip chip-sm\" :class=\"{ active: typeFilter === 'sell' }\" @click=\"typeFilter = 'sell'\">Buy</button>\n          <button class=\"chip chip-sm\" :class=\"{ active: typeFilter === 'trade' }\" @click=\"typeFilter = 'trade'\">Trade</button>\n          <button class=\"chip chip-sm\" :class=\"{ active: typeFilter === 'free' }\" @click=\"typeFilter = 'free'\">Free</button>\n        </div>\n      </div>\n    </div>\n\n    <!-- Results Count -->\n    <div class=\"results-info\">\n      <span>{{ filteredListings.length }} item{{ filteredListings.length !== 1 ? 's' : '' }} found</span>\n    </div>\n\n    <!-- Listings Grid -->\n    <div class=\"product-grid\">\n      <div v-if=\"filteredListings.length === 0\" class=\"empty-state\" style=\"grid-column: 1/-1;\">\n        <div class=\"empty-state-icon\">🔍</div>\n        <p>No items match your search. Try different filters or list something!</p>\n      </div>\n\n      <div v-for=\"listing in filteredListings\" :key=\"listing.id\" class=\"listing-card card\">\n        <!-- Image Placeholder -->\n        <div class=\"listing-image\" :style=\"{ background: getCategoryColor(listing.category) }\">\n          <span class=\"listing-image-icon\">{{ getCategoryIcon(listing.category) }}</span>\n          <div class=\"listing-badges\">\n            <span v-if=\"listing.type === 'free'\" class=\"badge badge-green\">FREE</span>\n            <span v-else-if=\"listing.type === 'trade'\" class=\"badge badge-blue\">TRADE</span>\n            <span v-if=\"listing.carbonSaved\" class=\"badge badge-green\">🌿 -{{ listing.carbonSaved }}kg CO₂</span>\n          </div>\n        </div>\n\n        <!-- Listing Info -->\n        <div class=\"listing-info\">\n          <div class=\"listing-top\">\n            <h3 class=\"listing-name\">{{ listing.name }}</h3>\n            <span class=\"listing-price\" v-if=\"listing.type !== 'free'\">${{ listing.price.toFixed(2) }}</span>\n            <span class=\"listing-price free\" v-else>Free</span>\n          </div>\n          <p class=\"listing-desc\">{{ listing.description }}</p>\n          <div class=\"listing-meta\">\n            <span class=\"badge badge-green\">{{ listing.conditionLabel }}</span>\n            <span class=\"listing-location\" v-if=\"listing.location\">📍 {{ listing.location }}</span>\n          </div>\n          <div class=\"listing-seller\">\n            <div class=\"avatar avatar-sm\">{{ listing.seller ? listing.seller.charAt(0).toUpperCase() : 'S' }}</div>\n            <span class=\"seller-name\">{{ listing.seller || 'Seller' }}</span>\n            <span class=\"seller-rating\" v-if=\"listing.rating\">⭐ {{ listing.rating.toFixed(1) }}</span>\n          </div>\n          <div class=\"listing-actions\">\n            <button class=\"btn btn-primary btn-sm\" @click=\"contactSeller(listing)\">\n              {{ listing.type === 'trade' ? 'Propose Trade' : listing.type === 'free' ? 'Request' : 'Buy Now' }}\n            </button>\n            <button class=\"btn btn-outline btn-sm\" @click=\"toggleFavorite(listing)\">\n              {{ listing.favorited ? '❤️' : '🤍' }}\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'MarketplaceView',\n  data() {\n    return {\n      showListingForm: false,\n      searchQuery: '',\n      activeCategory: '',\n      typeFilter: '',\n      sortBy: 'newest',\n      newListing: {\n        name: '',\n        price: 0,\n        category: '',\n        condition: 'good',\n        type: 'sell',\n        location: '',\n        description: ''\n      },\n      categories: [\n        { id: 'furniture', name: 'Furniture', icon: '🪑' },\n        { id: 'electronics', name: 'Electronics', icon: '📱' },\n        { id: 'clothing', name: 'Clothing', icon: '👕' },\n        { id: 'diy', name: 'DIY Materials', icon: '🔧' },\n        { id: 'garden', name: 'Garden', icon: '🌱' },\n        { id: 'kitchen', name: 'Kitchen', icon: '🍳' },\n        { id: 'books', name: 'Books', icon: '📚' },\n        { id: 'sports', name: 'Sports', icon: '⚽' }\n      ],\n      listings: []\n    }\n  },\n  computed: {\n    currentUser() {\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\n    },\n    canCreateListing() {\n      return this.newListing.name.trim() && this.newListing.category && this.newListing.description.trim()\n    },\n    filteredListings() {\n      let result = [...this.listings]\n      if (this.searchQuery) {\n        const q = this.searchQuery.toLowerCase()\n        result = result.filter(l =>\n          l.name.toLowerCase().includes(q) ||\n          l.description.toLowerCase().includes(q) ||\n          (l.location || '').toLowerCase().includes(q)\n        )\n      }\n      if (this.activeCategory) {\n        result = result.filter(l => l.category === this.activeCategory)\n      }\n      if (this.typeFilter) {\n        result = result.filter(l => l.type === this.typeFilter)\n      }\n      switch (this.sortBy) {\n        case 'price-low': result.sort((a, b) => a.price - b.price); break\n        case 'price-high': result.sort((a, b) => b.price - a.price); break\n        case 'rating': result.sort((a, b) => (b.rating || 0) - (a.rating || 0)); break\n        default: result.sort((a, b) => b.id - a.id)\n      }\n      return result\n    }\n  },\n  created() {\n    this.loadListings()\n  },\n  methods: {\n    getCategoryIcon(catId) {\n      const cat = this.categories.find(c => c.id === catId)\n      return cat ? cat.icon : '📦'\n    },\n    getCategoryColor(catId) {\n      const colors = {\n        furniture: 'linear-gradient(135deg, #a8d8a8, #6bb86b)',\n        electronics: 'linear-gradient(135deg, #90caf9, #42a5f5)',\n        clothing: 'linear-gradient(135deg, #ce93d8, #ab47bc)',\n        diy: 'linear-gradient(135deg, #ffcc80, #ffa726)',\n        garden: 'linear-gradient(135deg, #a5d6a7, #66bb6a)',\n        kitchen: 'linear-gradient(135deg, #ef9a9a, #ef5350)',\n        books: 'linear-gradient(135deg, #b39ddb, #7e57c2)',\n        sports: 'linear-gradient(135deg, #80deea, #26c6da)'\n      }\n      return colors[catId] || 'linear-gradient(135deg, #e0e0e0, #bdbdbd)'\n    },\n    conditionLabel(cond) {\n      const labels = { 'new': 'New', 'like-new': 'Like New', 'good': 'Good', 'fair': 'Fair' }\n      return labels[cond] || cond\n    },\n    createListing() {\n      if (!this.canCreateListing) return\n      const carbonMap = { furniture: 25, electronics: 15, clothing: 8, diy: 10, garden: 5, kitchen: 6, books: 3, sports: 7 }\n      const listing = {\n        id: Date.now(),\n        name: this.newListing.name.trim(),\n        price: this.newListing.type === 'free' ? 0 : Number(this.newListing.price) || 0,\n        category: this.newListing.category,\n        condition: this.newListing.condition,\n        conditionLabel: this.conditionLabel(this.newListing.condition),\n        type: this.newListing.type,\n        location: this.newListing.location.trim(),\n        description: this.newListing.description.trim(),\n        seller: this.currentUser.name || this.currentUser.email || 'Anonymous',\n        rating: null,\n        carbonSaved: carbonMap[this.newListing.category] || 5,\n        favorited: false,\n        date: new Date().toISOString()\n      }\n      this.listings.unshift(listing)\n      this.saveListings()\n      this.showListingForm = false\n      this.newListing = { name: '', price: 0, category: '', condition: 'good', type: 'sell', location: '', description: '' }\n    },\n    toggleFavorite(listing) {\n      listing.favorited = !listing.favorited\n      this.saveListings()\n    },\n    contactSeller(listing) {\n      const messages = JSON.parse(localStorage.getItem('susty_messages') || '[]')\n      messages.push({\n        id: Date.now(),\n        from: this.currentUser.name || this.currentUser.email || 'User',\n        to: listing.seller,\n        content: `Hi! I'm interested in your listing: \"${listing.name}\"`,\n        date: new Date().toISOString(),\n        read: false\n      })\n      localStorage.setItem('susty_messages', JSON.stringify(messages))\n    },\n    loadListings() {\n      const saved = localStorage.getItem('susty_listings')\n      if (saved) {\n        this.listings = JSON.parse(saved)\n      } else {\n        this.listings = [\n          { id: 1, name: 'Eco-friendly Water Bottle', description: 'Reusable stainless steel bottle, 750ml. Used for 2 months.', price: 19.99, category: 'kitchen', condition: 'like-new', conditionLabel: 'Like New', type: 'sell', location: 'Portland, OR', seller: 'EcoWarrior', rating: 4.8, carbonSaved: 6, favorited: false, date: '2026-03-28T10:00:00Z' },\n          { id: 2, name: 'Solar Power Bank', description: 'Charge your devices anywhere with solar energy. 20000mAh capacity.', price: 39.99, category: 'electronics', condition: 'new', conditionLabel: 'New', type: 'sell', location: 'Austin, TX', seller: 'SolarSteve', rating: 4.5, carbonSaved: 15, favorited: false, date: '2026-03-27T14:00:00Z' },\n          { id: 3, name: 'Bamboo Toothbrush Set', description: 'Set of 4 biodegradable bamboo toothbrushes. Never opened.', price: 12.99, category: 'kitchen', condition: 'new', conditionLabel: 'New', type: 'sell', location: 'Seattle, WA', seller: 'GreenGuru', rating: 4.9, carbonSaved: 3, favorited: false, date: '2026-03-26T09:00:00Z' },\n          { id: 4, name: 'Vintage Wooden Desk', description: 'Solid oak desk from the 1970s. A few scratches but structurally perfect.', price: 85.00, category: 'furniture', condition: 'good', conditionLabel: 'Good', type: 'sell', location: 'Denver, CO', seller: 'RetroRick', rating: 4.2, carbonSaved: 25, favorited: false, date: '2026-03-25T16:00:00Z' },\n          { id: 5, name: 'Kids Clothing Bundle', description: '10 pieces of gently used kids clothing, ages 4-6. Mixed brands.', price: 0, category: 'clothing', condition: 'good', conditionLabel: 