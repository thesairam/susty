{"ast":null,"code":"export default {\n  name: 'ChallengesView',\n  data() {\n    return {\n      tab: 'weekly',\n      progress: {},\n      challenges: [{\n        id: 'pw1',\n        name: 'Plastic-Free Week',\n        icon: '🚫',\n        description: 'Avoid all single-use plastics for 7 days. Bring your own bags, bottles, and containers.',\n        difficulty: 'Medium',\n        type: 'weekly',\n        participants: 234,\n        co2Impact: 3.5,\n        daysLeft: 5\n      }, {\n        id: 'pw2',\n        name: 'Bike to Work',\n        icon: '🚲',\n        description: 'Commute by bicycle for one full week. Track your rides!',\n        difficulty: 'Easy',\n        type: 'weekly',\n        participants: 156,\n        co2Impact: 8.2,\n        daysLeft: 5\n      }, {\n        id: 'pw3',\n        name: 'Zero Food Waste',\n        icon: '🥗',\n        description: 'Plan meals and use every bit of food. Compost what you can\\'t eat.',\n        difficulty: 'Medium',\n        type: 'weekly',\n        participants: 189,\n        co2Impact: 4.1,\n        daysLeft: 5\n      }, {\n        id: 'pw4',\n        name: 'Cold Shower Challenge',\n        icon: '🚿',\n        description: 'Take cold showers for a week to save energy on water heating.',\n        difficulty: 'Hard',\n        type: 'weekly',\n        participants: 87,\n        co2Impact: 2.8,\n        daysLeft: 5\n      }, {\n        id: 'pm1',\n        name: 'Plant 5 Trees',\n        icon: '🌳',\n        description: 'Plant 5 trees this month in your community or support a tree-planting org.',\n        difficulty: 'Medium',\n        type: 'monthly',\n        participants: 412,\n        co2Impact: 110,\n        daysLeft: 20\n      }, {\n        id: 'pm2',\n        name: '30-Day Minimalism',\n        icon: '📦',\n        description: 'Each day, donate or recycle one item you no longer need.',\n        difficulty: 'Easy',\n        type: 'monthly',\n        participants: 321,\n        co2Impact: 15,\n        daysLeft: 20\n      }, {\n        id: 'pm3',\n        name: 'Local Food Only',\n        icon: '🥕',\n        description: 'Buy only locally-produced food for the entire month.',\n        difficulty: 'Hard',\n        type: 'monthly',\n        participants: 198,\n        co2Impact: 25,\n        daysLeft: 20\n      }, {\n        id: 'pm4',\n        name: 'Energy Audit',\n        icon: '💡',\n        description: 'Audit your home energy usage and reduce it by 20% this month.',\n        difficulty: 'Medium',\n        type: 'monthly',\n        participants: 267,\n        co2Impact: 40,\n        daysLeft: 20\n      }],\n      rewards: [{\n        id: 1,\n        icon: '🌱',\n        name: 'Green Starter',\n        requirement: 'Complete 1 challenge'\n      }, {\n        id: 2,\n        icon: '🌿',\n        name: 'Eco Warrior',\n        requirement: 'Complete 5 challenges'\n      }, {\n        id: 3,\n        icon: '🌍',\n        name: 'Planet Protector',\n        requirement: 'Complete 10 challenges'\n      }, {\n        id: 4,\n        icon: '♾️',\n        name: 'Sustainability Legend',\n        requirement: 'Complete 25 challenges'\n      }]\n    };\n  },\n  computed: {\n    currentUser() {\n      try {\n        return JSON.parse(localStorage.getItem('currentUser')) || {};\n      } catch {\n        return {};\n      }\n    },\n    currentUserName() {\n      return this.currentUser.name || this.currentUser.email || 'User';\n    },\n    activeChallenge() {\n      return this.challenges[0];\n    },\n    filteredChallenges() {\n      return this.challenges.filter(c => c.type === this.tab);\n    },\n    leaderboard() {\n      const completedCount = Object.values(this.progress).filter(v => v === 'completed').length;\n      const entries = [{\n        name: 'EcoWarrior',\n        completed: 15,\n        co2: 245,\n        points: 1500\n      }, {\n        name: 'GreenGuru',\n        completed: 12,\n        co2: 198,\n        points: 1200\n      }, {\n        name: 'SolarSteve',\n        completed: 10,\n        co2: 165,\n        points: 1000\n      }, {\n        name: this.currentUserName,\n        completed: completedCount,\n        co2: (completedCount * 12).toFixed(0),\n        points: completedCount * 100,\n        isYou: true\n      }, {\n        name: 'TreeHugger',\n        completed: 8,\n        co2: 132,\n        points: 800\n      }, {\n        name: 'ZeroWasteZoe',\n        completed: 7,\n        co2: 115,\n        points: 700\n      }, {\n        name: 'BikeRider',\n        completed: 5,\n        co2: 82,\n        points: 500\n      }];\n      return entries.sort((a, b) => b.points - a.points);\n    }\n  },\n  created() {\n    this.loadProgress();\n  },\n  methods: {\n    getStatus(challengeId) {\n      return this.progress[challengeId] || 'none';\n    },\n    getProgress(challengeId) {\n      const status = this.progress[challengeId];\n      if (status === 'completed') return 100;\n      if (status === 'joined') return 40;\n      return 0;\n    },\n    joinChallenge(challenge) {\n      this.progress[challenge.id] = 'joined';\n      challenge.participants = (challenge.participants || 0) + 1;\n      this.saveProgress();\n    },\n    completeChallenge(challenge) {\n      this.progress[challenge.id] = 'completed';\n      this.saveProgress();\n    },\n    loadProgress() {\n      const saved = localStorage.getItem('susty_challenges_progress');\n      if (saved) this.progress = JSON.parse(saved);\n    },\n    saveProgress() {\n      localStorage.setItem('susty_challenges_progress', JSON.stringify(this.progress));\n    }\n  }\n};","map":{"version":3,"names":["name","data","tab","progress","challenges","id","icon","description","difficulty","type","participants","co2Impact","daysLeft","rewards","requirement","computed","currentUser","JSON","parse","localStorage","getItem","currentUserName","email","activeChallenge","filteredChallenges","filter","c","leaderboard","completedCount","Object","values","v","length","entries","completed","co2","points","toFixed","isYou","sort","a","b","created","loadProgress","methods","getStatus","challengeId","getProgress","status","joinChallenge","challenge","saveProgress","completeChallenge","saved","setItem","stringify"],"sources":["/home/rare/projects/susty/src/views/Challenges.vue"],"sourcesContent":["<template>\r\n  <div class=\"challenges\">\r\n    <div class=\"challenges-header\">\r\n      <div>\r\n        <h1>🏆 Community Challenges</h1>\r\n        <p class=\"challenges-subtitle\">Join weekly and monthly sustainability challenges. Earn badges and climb the leaderboard!</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Active Challenge Spotlight -->\r\n    <div class=\"spotlight card\">\r\n      <div class=\"spotlight-badge\">🔥 THIS WEEK</div>\r\n      <h2>{{ activeChallenge.name }}</h2>\r\n      <p>{{ activeChallenge.description }}</p>\r\n      <div class=\"spotlight-meta\">\r\n        <span>⏳ {{ activeChallenge.daysLeft }} days left</span>\r\n        <span>👥 {{ activeChallenge.participants }} participants</span>\r\n        <span>🌿 {{ activeChallenge.co2Impact }} kg CO₂ impact</span>\r\n      </div>\r\n      <div class=\"spotlight-progress\">\r\n        <div class=\"progress-bar\">\r\n          <div class=\"progress-fill\" :style=\"{ width: getProgress(activeChallenge.id) + '%' }\"></div>\r\n        </div>\r\n        <span class=\"progress-text\">{{ getProgress(activeChallenge.id) }}% complete</span>\r\n      </div>\r\n      <div class=\"spotlight-actions\">\r\n        <button\r\n          v-if=\"getStatus(activeChallenge.id) === 'none'\"\r\n          class=\"btn btn-primary btn-lg\"\r\n          @click=\"joinChallenge(activeChallenge)\"\r\n        >Join Challenge</button>\r\n        <button\r\n          v-else-if=\"getStatus(activeChallenge.id) === 'joined'\"\r\n          class=\"btn btn-primary btn-lg\"\r\n          @click=\"completeChallenge(activeChallenge)\"\r\n        >✅ Mark Complete</button>\r\n        <span v-else class=\"completed-badge\">🎉 Completed!</span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Tabs -->\r\n    <div class=\"tabs\">\r\n      <button class=\"tab\" :class=\"{ active: tab === 'weekly' }\" @click=\"tab = 'weekly'\">Weekly</button>\r\n      <button class=\"tab\" :class=\"{ active: tab === 'monthly' }\" @click=\"tab = 'monthly'\">Monthly</button>\r\n      <button class=\"tab\" :class=\"{ active: tab === 'leaderboard' }\" @click=\"tab = 'leaderboard'\">Leaderboard</button>\r\n    </div>\r\n\r\n    <!-- Challenge Cards -->\r\n    <div v-if=\"tab !== 'leaderboard'\" class=\"challenges-grid\">\r\n      <div v-for=\"challenge in filteredChallenges\" :key=\"challenge.id\" class=\"challenge-card card\">\r\n        <div class=\"challenge-icon\">{{ challenge.icon }}</div>\r\n        <div class=\"challenge-info\">\r\n          <h3>{{ challenge.name }}</h3>\r\n          <p class=\"challenge-desc\">{{ challenge.description }}</p>\r\n          <div class=\"challenge-meta\">\r\n            <span class=\"badge\" :class=\"challenge.difficulty === 'Easy' ? 'badge-green' : challenge.difficulty === 'Medium' ? 'badge-blue' : 'badge-orange'\">\r\n              {{ challenge.difficulty }}\r\n            </span>\r\n            <span>👥 {{ challenge.participants }}</span>\r\n            <span>🌿 {{ challenge.co2Impact }} kg CO₂</span>\r\n          </div>\r\n          <div class=\"challenge-progress\" v-if=\"getStatus(challenge.id) !== 'none'\">\r\n            <div class=\"progress-bar\">\r\n              <div class=\"progress-fill\" :style=\"{ width: getProgress(challenge.id) + '%' }\"></div>\r\n            </div>\r\n          </div>\r\n          <div class=\"challenge-actions\">\r\n            <button\r\n              v-if=\"getStatus(challenge.id) === 'none'\"\r\n              class=\"btn btn-outline btn-sm\"\r\n              @click=\"joinChallenge(challenge)\"\r\n            >Join</button>\r\n            <button\r\n              v-else-if=\"getStatus(challenge.id) === 'joined'\"\r\n              class=\"btn btn-primary btn-sm\"\r\n              @click=\"completeChallenge(challenge)\"\r\n            >Complete</button>\r\n            <span v-else class=\"completed-text\">✅ Done</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Leaderboard -->\r\n    <div v-if=\"tab === 'leaderboard'\" class=\"leaderboard card\">\r\n      <div class=\"leaderboard-row header\">\r\n        <span class=\"lb-rank\">#</span>\r\n        <span class=\"lb-user\">User</span>\r\n        <span class=\"lb-challenges\">Challenges</span>\r\n        <span class=\"lb-co2\">CO₂ Saved</span>\r\n        <span class=\"lb-points\">Points</span>\r\n      </div>\r\n      <div v-for=\"(entry, index) in leaderboard\" :key=\"entry.name\" class=\"leaderboard-row\" :class=\"{ 'is-you': entry.isYou }\">\r\n        <span class=\"lb-rank\">\r\n          <span v-if=\"index === 0\">🥇</span>\r\n          <span v-else-if=\"index === 1\">🥈</span>\r\n          <span v-else-if=\"index === 2\">🥉</span>\r\n          <span v-else>{{ index + 1 }}</span>\r\n        </span>\r\n        <span class=\"lb-user\">\r\n          <div class=\"avatar avatar-sm\">{{ entry.name.charAt(0).toUpperCase() }}</div>\r\n          {{ entry.name }} <span v-if=\"entry.isYou\" class=\"you-tag\">(You)</span>\r\n        </span>\r\n        <span class=\"lb-challenges\">{{ entry.completed }}</span>\r\n        <span class=\"lb-co2\">{{ entry.co2 }} kg</span>\r\n        <span class=\"lb-points\">{{ entry.points }}</span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Rewards Section -->\r\n    <section class=\"rewards-section\">\r\n      <h2 class=\"section-title\">🎖️ Challenge Rewards</h2>\r\n      <div class=\"grid-4\">\r\n        <div class=\"card reward-card\" v-for=\"reward in rewards\" :key=\"reward.id\">\r\n          <span class=\"reward-icon\">{{ reward.icon }}</span>\r\n          <strong>{{ reward.name }}</strong>\r\n          <span class=\"reward-req\">{{ reward.requirement }}</span>\r\n        </div>\r\n      </div>\r\n    </section>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ChallengesView',\r\n  data() {\r\n    return {\r\n      tab: 'weekly',\r\n      progress: {},\r\n      challenges: [\r\n        { id: 'pw1', name: 'Plastic-Free Week', icon: '🚫', description: 'Avoid all single-use plastics for 7 days. Bring your own bags, bottles, and containers.', difficulty: 'Medium', type: 'weekly', participants: 234, co2Impact: 3.5, daysLeft: 5 },\r\n        { id: 'pw2', name: 'Bike to Work', icon: '🚲', description: 'Commute by bicycle for one full week. Track your rides!', difficulty: 'Easy', type: 'weekly', participants: 156, co2Impact: 8.2, daysLeft: 5 },\r\n        { id: 'pw3', name: 'Zero Food Waste', icon: '🥗', description: 'Plan meals and use every bit of food. Compost what you can\\'t eat.', difficulty: 'Medium', type: 'weekly', participants: 189, co2Impact: 4.1, daysLeft: 5 },\r\n        { id: 'pw4', name: 'Cold Shower Challenge', icon: '🚿', description: 'Take cold showers for a week to save energy on water heating.', difficulty: 'Hard', type: 'weekly', participants: 87, co2Impact: 2.8, daysLeft: 5 },\r\n        { id: 'pm1', name: 'Plant 5 Trees', icon: '🌳', description: 'Plant 5 trees this month in your community or support a tree-planting org.', difficulty: 'Medium', type: 'monthly', participants: 412, co2Impact: 110, daysLeft: 20 },\r\n        { id: 'pm2', name: '30-Day Minimalism', icon: '📦', description: 'Each day, donate or recycle one item you no longer need.', difficulty: 'Easy', type: 'monthly', participants: 321, co2Impact: 15, daysLeft: 20 },\r\n        { id: 'pm3', name: 'Local Food Only', icon: '🥕', description: 'Buy only locally-produced food for the entire month.', difficulty: 'Hard', type: 'monthly', participants: 198, co2Impact: 25, daysLeft: 20 },\r\n        { id: 'pm4', name: 'Energy Audit', icon: '💡', description: 'Audit your home energy usage and reduce it by 20% this month.', difficulty: 'Medium', type: 'monthly', participants: 267, co2Impact: 40, daysLeft: 20 }\r\n      ],\r\n      rewards: [\r\n        { id: 1, icon: '🌱', name: 'Green Starter', requirement: 'Complete 1 challenge' },\r\n        { id: 2, icon: '🌿', name: 'Eco Warrior', requirement: 'Complete 5 challenges' },\r\n        { id: 3, icon: '🌍', name: 'Planet Protector', requirement: 'Complete 10 challenges' },\r\n        { id: 4, icon: '♾️', name: 'Sustainability Legend', requirement: 'Complete 25 challenges' }\r\n      ]\r\n    }\r\n  },\r\n  computed: {\r\n    currentUser() {\r\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\r\n    },\r\n    currentUserName() {\r\n      return this.currentUser.name || this.currentUser.email || 'User'\r\n    },\r\n    activeChallenge() {\r\n      return this.challenges[0]\r\n    },\r\n    filteredChallenges() {\r\n      return this.challenges.filter(c => c.type === this.tab)\r\n    },\r\n    leaderboard() {\r\n      const completedCount = Object.values(this.progress).filter(v => v === 'completed').length\r\n      const entries = [\r\n        { name: 'EcoWarrior', completed: 15, co2: 245, points: 1500 },\r\n        { name: 'GreenGuru', completed: 12, co2: 198, points: 1200 },\r\n        { name: 'SolarSteve', completed: 10, co2: 165, points: 1000 },\r\n        { name: this.currentUserName, completed: completedCount, co2: (completedCount * 12).toFixed(0), points: completedCount * 100, isYou: true },\r\n        { name: 'TreeHugger', completed: 8, co2: 132, points: 800 },\r\n        { name: 'ZeroWasteZoe', completed: 7, co2: 115, points: 700 },\r\n        { name: 'BikeRider', completed: 5, co2: 82, points: 500 }\r\n      ]\r\n      return entries.sort((a, b) => b.points - a.points)\r\n    }\r\n  },\r\n  created() {\r\n    this.loadProgress()\r\n  },\r\n  methods: {\r\n    getStatus(challengeId) {\r\n      return this.progress[challengeId] || 'none'\r\n    },\r\n    getProgress(challengeId) {\r\n      const status = this.progress[challengeId]\r\n      if (status === 'completed') return 100\r\n      if (status === 'joined') return 40\r\n      return 0\r\n    },\r\n    joinChallenge(challenge) {\r\n      this.progress[challenge.id] = 'joined'\r\n      challenge.participants = (challenge.participants || 0) + 1\r\n      this.saveProgress()\r\n    },\r\n    completeChallenge(challenge) {\r\n      this.progress[challenge.id] = 'completed'\r\n      this.saveProgress()\r\n    },\r\n    loadProgress() {\r\n      const saved = localStorage.getItem('susty_challenges_progress')\r\n      if (saved) this.progress = JSON.parse(saved)\r\n    },\r\n    saveProgress() {\r\n      localStorage.setItem('susty_challenges_progress', JSON.stringify(this.progress))\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.challenges-header { margin-bottom: 1.5rem; }\r\n.challenges-header h1 { margin: 0 0 0.25rem; font-size: 1.8rem; }\r\n.challenges-subtitle { color: var(--muted-text); margin: 0; }\r\n\r\n.spotlight {\r\n  background: linear-gradient(135deg, var(--primary-green), var(--primary-blue));\r\n  color: white;\r\n  margin-bottom: 1.5rem;\r\n  position: relative;\r\n  overflow: hidden;\r\n}\r\n.spotlight-badge {\r\n  display: inline-block;\r\n  background: rgba(255,255,255,0.2);\r\n  padding: 0.25rem 0.75rem;\r\n  border-radius: 12px;\r\n  font-size: 0.8rem;\r\n  font-weight: 700;\r\n  margin-bottom: 0.75rem;\r\n}\r\n.spotlight h2 { margin: 0 0 0.5rem; font-size: 1.5rem; }\r\n.spotlight p { opacity: 0.9; margin: 0 0 1rem; }\r\n.spotlight-meta { display: flex; gap: 1.5rem; margin-bottom: 1rem; font-size: 0.9rem; opacity: 0.85; }\r\n.spotlight-progress { margin-bottom: 1rem; }\r\n.progress-bar { height: 8px; background: rgba(255,255,255,0.3); border-radius: 4px; overflow: hidden; }\r\n.progress-fill { height: 100%; background: white; border-radius: 4px; transition: width 0.6s ease; }\r\n.progress-text { font-size: 0.8rem; opacity: 0.8; }\r\n.spotlight-actions { display: flex; align-items: center; gap: 1rem; }\r\n.spotlight .btn-primary { background: white; color: var(--primary-green); }\r\n.spotlight .btn-primary:hover { background: rgba(255,255,255,0.9); }\r\n.completed-badge { font-size: 1.2rem; font-weight: 700; }\r\n\r\n.challenges-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));\r\n  gap: 1.25rem;\r\n  margin-bottom: 2rem;\r\n}\r\n.challenge-card {\r\n  display: flex;\r\n  gap: 1rem;\r\n  align-items: flex-start;\r\n}\r\n.challenge-icon { font-size: 2.5rem; flex-shrink: 0; }\r\n.challenge-info { flex: 1; }\r\n.challenge-info h3 { margin: 0 0 0.25rem; font-size: 1rem; }\r\n.challenge-desc { font-size: 0.85rem; color: var(--muted-text); margin: 0 0 0.5rem; line-height: 1.4; }\r\n.challenge-meta { display: flex; gap: 0.75rem; align-items: center; font-size: 0.8rem; color: var(--muted-text); margin-bottom: 0.5rem; flex-wrap: wrap; }\r\n.challenge-progress { margin-bottom: 0.5rem; }\r\n.challenge-progress .progress-bar { background: var(--border-color); }\r\n.challenge-progress .progress-fill { background: var(--primary-green); }\r\n.challenge-actions { margin-top: 0.25rem; }\r\n.completed-text { color: var(--primary-green); font-weight: 600; font-size: 0.85rem; }\r\n\r\n.leaderboard { padding: 0; overflow: hidden; margin-bottom: 2rem; }\r\n.leaderboard-row {\r\n  display: grid;\r\n  grid-template-columns: 50px 1fr 100px 100px 80px;\r\n  align-items: center;\r\n  padding: 0.85rem 1.25rem;\r\n  border-bottom: 1px solid var(--border-color);\r\n  font-size: 0.9rem;\r\n}\r\n.leaderboard-row.header { font-weight: 700; background: var(--light-bg); font-size: 0.8rem; color: var(--muted-text); text-transform: uppercase; }\r\n.leaderboard-row.is-you { background: var(--light-green); }\r\n.lb-user { display: flex; align-items: center; gap: 0.5rem; }\r\n.you-tag { font-size: 0.75rem; color: var(--primary-green); }\r\n\r\n.rewards-section { margin-bottom: 2rem; }\r\n.reward-card { text-align: center; }\r\n.reward-icon { font-size: 2rem; display: block; margin-bottom: 0.5rem; }