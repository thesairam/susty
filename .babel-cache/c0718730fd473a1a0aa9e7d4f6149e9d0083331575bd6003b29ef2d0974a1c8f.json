,"_hoisted_47","likes","views","_hoisted_48","tag","_hoisted_41","selectedArticle","_withModifiers","_hoisted_49","_hoisted_50","_hoisted_51","_hoisted_52","_createTextVNode","_hoisted_53","split","para","i","_hoisted_54","likeArticle"],"sources":["/home/rare/projects/susty/src/views/Knowledge.vue"],"sourcesContent":["<template>\r\n  <div class=\"knowledge\">\r\n    <div class=\"knowledge-header\">\r\n      <div>\r\n        <h1>📚 Knowledge Hub</h1>\r\n        <p class=\"knowledge-subtitle\">Curated sustainability guides, tutorials, and community knowledge.</p>\r\n      </div>\r\n      <button class=\"btn btn-primary\" @click=\"showCreateForm = !showCreateForm\">\r\n        {{ showCreateForm ? '✕ Cancel' : '+ Write a Guide' }}\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Create Article Form -->\r\n    <div v-if=\"showCreateForm\" class=\"card article-form\">\r\n      <h3>Write a Guide or Tutorial</h3>\r\n      <div class=\"form-group\">\r\n        <label class=\"form-label\">Title</label>\r\n        <input v-model=\"newArticle.title\" class=\"form-input\" placeholder=\"Guide title...\" />\r\n      </div>\r\n      <div class=\"form-row\">\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Category</label>\r\n          <select v-model=\"newArticle.category\" class=\"form-select\">\r\n            <option value=\"\">Select category</option>\r\n            <option v-for=\"cat in categories\" :key=\"cat.id\" :value=\"cat.id\">{{ cat.icon }} {{ cat.name }}</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label class=\"form-label\">Difficulty</label>\r\n          <select v-model=\"newArticle.difficulty\" class=\"form-select\">\r\n            <option value=\"beginner\">Beginner</option>\r\n            <option value=\"intermediate\">Intermediate</option>\r\n            <option value=\"advanced\">Advanced</option>\r\n          </select>\r\n        </div>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label class=\"form-label\">Content</label>\r\n        <textarea v-model=\"newArticle.content\" class=\"form-textarea\" rows=\"8\" placeholder=\"Write your guide content here...\"></textarea>\r\n      </div>\r\n      <div class=\"form-group\">\r\n        <label class=\"form-label\">Tags (comma-separated)</label>\r\n        <input v-model=\"newArticle.tags\" class=\"form-input\" placeholder=\"composting, zero-waste, garden\" />\r\n      </div>\r\n      <div class=\"form-actions\">\r\n        <button class=\"btn btn-primary\" @click=\"publishArticle\" :disabled=\"!canPublish\">Publish</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Search & Filters -->\r\n    <div class=\"filter-bar card\">\r\n      <input v-model=\"searchQuery\" class=\"form-input\" placeholder=\"🔍 Search guides and tutorials...\" />\r\n      <div class=\"filter-chips\">\r\n        <button class=\"chip\" :class=\"{ active: activeCategory === '' }\" @click=\"activeCategory = ''\">All</button>\r\n        <button\r\n          v-for=\"cat in categories\"\r\n          :key=\"cat.id\"\r\n          class=\"chip\"\r\n          :class=\"{ active: activeCategory === cat.id }\"\r\n          @click=\"activeCategory = cat.id\"\r\n        >{{ cat.icon }} {{ cat.name }}</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Featured Guides -->\r\n    <section v-if=\"!searchQuery && !activeCategory\" class=\"featured-section\">\r\n      <h2 class=\"section-title\">⭐ Featured Guides</h2>\r\n      <div class=\"featured-grid\">\r\n        <div v-for=\"article in featuredArticles\" :key=\"article.id\" class=\"featured-card card\" @click=\"openArticle(article)\">\r\n          <div class=\"featured-image\" :style=\"{ background: getCatColor(article.category) }\">\r\n            <span>{{ getCatIcon(article.category) }}</span>\r\n          </div>\r\n          <div class=\"featured-info\">\r\n            <span class=\"badge badge-green\">{{ getCatName(article.category) }}</span>\r\n            <h3>{{ article.title }}</h3>\r\n            <div class=\"article-meta\">\r\n              <span>By {{ article.author }}</span>\r\n              <span>📖 {{ article.readTime }} min read</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- All Articles -->\r\n    <section>\r\n      <h2 class=\"section-title\" v-if=\"!searchQuery && !activeCategory\">📖 All Guides</h2>\r\n      <div v-if=\"filteredArticles.length === 0\" class=\"empty-state\">\r\n        <div class=\"empty-state-icon\">📚</div>\r\n        <p>No guides found. Be the first to write one!</p>\r\n      </div>\r\n      <div class=\"articles-list\">\r\n        <div v-for=\"article in filteredArticles\" :key=\"article.id\" class=\"article-card card\" @click=\"openArticle(article)\">\r\n          <div class=\"article-icon\" :style=\"{ background: getCatColor(article.category) }\">\r\n            {{ getCatIcon(article.category) }}\r\n          </div>\r\n          <div class=\"article-body\">\r\n            <div class=\"article-badges\">\r\n              <span class=\"badge badge-green\">{{ getCatName(article.category) }}</span>\r\n              <span class=\"badge\" :class=\"article.difficulty === 'beginner' ? 'badge-green' : article.difficulty === 'intermediate' ? 'badge-blue' : 'badge-orange'\">{{ article.difficulty }}</span>\r\n            </div>\r\n            <h3>{{ article.title }}</h3>\r\n            <p class=\"article-excerpt\">{{ article.content.substring(0, 150) }}...</p>\r\n            <div class=\"article-footer\">\r\n              <span class=\"article-author\">By {{ article.author }}</span>\r\n              <span>📖 {{ article.readTime }} min</span>\r\n              <span>❤️ {{ article.likes }}</span>\r\n              <span>👁️ {{ article.views }}</span>\r\n            </div>\r\n            <div class=\"article-tags\" v-if=\"article.tags && article.tags.length\">\r\n              <span class=\"hashtag\" v-for=\"tag in article.tags\" :key=\"tag\">#{{ tag }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- Article Modal -->\r\n    <div v-if=\"selectedArticle\" class=\"modal-overlay\" @click.self=\"selectedArticle = null\">\r\n      <div class=\"modal card\">\r\n        <button class=\"modal-close\" @click=\"selectedArticle = null\">✕</button>\r\n        <div class=\"modal-header\">\r\n          <span class=\"badge badge-green\">{{ getCatName(selectedArticle.category) }}</span>\r\n          <span class=\"badge\" :class=\"selectedArticle.difficulty === 'beginner' ? 'badge-green' : selectedArticle.difficulty === 'intermediate' ? 'badge-blue' : 'badge-orange'\">{{ selectedArticle.difficulty }}</span>\r\n        </div>\r\n        <h2>{{ selectedArticle.title }}</h2>\r\n        <div class=\"modal-meta\">\r\n          <span>By <strong>{{ selectedArticle.author }}</strong></span>\r\n          <span>📖 {{ selectedArticle.readTime }} min read</span>\r\n          <span>❤️ {{ selectedArticle.likes }}</span>\r\n        </div>\r\n        <div class=\"modal-content\">\r\n          <p v-for=\"(para, i) in selectedArticle.content.split('\\n\\n')\" :key=\"i\">{{ para }}</p>\r\n        </div>\r\n        <div class=\"modal-actions\">\r\n          <button class=\"btn btn-outline btn-sm\" @click=\"likeArticle(selectedArticle)\">❤️ Like</button>\r\n          <button class=\"btn btn-outline btn-sm\" @click=\"selectedArticle = null\">Close</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'KnowledgeView',\r\n  data() {\r\n    return {\r\n      showCreateForm: false,\r\n      searchQuery: '',\r\n      activeCategory: '',\r\n      selectedArticle: null,\r\n      newArticle: {\r\n        title: '',\r\n        category: '',\r\n        difficulty: 'beginner',\r\n        content: '',\r\n        tags: ''\r\n      },\r\n      categories: [\r\n        { id: 'composting', name: 'Composting', icon: '🌱' },\r\n        { id: 'minimalism', name: 'Minimalism', icon: '📦' },\r\n        { id: 'energy', name: 'Energy Saving', icon: '💡' },\r\n        { id: 'food', name: 'Sustainable Food', icon: '🥗' },\r\n        { id: 'fashion', name: 'Eco Fashion', icon: '👗' },\r\n        { id: 'transport', name: 'Green Transport', icon: '🚲' },\r\n        { id: 'water', name: 'Water Conservation', icon: '💧' },\r\n        { id: 'diy', name: 'DIY & Repair', icon: '🔧' }\r\n      ],\r\n      articles: []\r\n    }\r\n  },\r\n  computed: {\r\n    currentUser() {\r\n      try { return JSON.parse(localStorage.getItem('currentUser')) || {} } catch { return {} }\r\n    },\r\n    canPublish() {\r\n      return this.newArticle.title.trim() && this.newArticle.category && this.newArticle.content.trim()\r\n    },\r\n    featuredArticles() {\r\n      return [...this.articles].sort((a, b) => b.likes - a.likes).slice(0, 3)\r\n    },\r\n    filteredArticles() {\r\n      let result = [...this.articles]\r\n      if (this.searchQuery) {\r\n        const q = this.searchQuery.toLowerCase()\r\n        result = result.filter(a =>\r\n          a.title.toLowerCase().includes(q) ||\r\n          a.content.toLowerCase().includes(q) ||\r\n          (a.tags || []).some(t => t.toLowerCase().includes(q))\r\n        )\r\n      }\r\n      if (this.activeCategory) {\r\n        result = result.filter(a => a.category === this.activeCategory)\r\n      }\r\n      return result\r\n    }\r\n  },\r\n  created() {\r\n    this.loadArticles()\r\n  },\r\n  methods: {\r\n    getCatIcon(id) {\r\n      const cat = this.categories.find(c => c.id === id)\r\n      return cat ? cat.icon : '📖'\r\n    },\r\n    getCatName(id) {\r\n      const cat = this.categories.find(c => c.id === id)\r\n      return cat ? cat.name : 'General'\r\n    },\r\n    getCatColor(id) {\r\n      const colors = {\r\n        composting: 'linear-gradient(135deg, #66BB6A, #43A047)',\r\n        minimalism: 'linear-gradient(135deg, #90CAF9, #42A5F5)',\r\n        energy: 'linear-gradient(135deg, #FFD54F, #FFC107)',\r\n        food: 'linear-gradient(135deg, #A5D6A7, #66BB6A)',\r\n        fashion: 'linear-gradient(135deg, #CE93D8, #AB47BC)',\r\n        transport: 'linear-gradient(135deg, #80DEEA, #26C6DA)',\r\n        water: 'linear-gradient(135deg, #81D4FA, #29B6F6)',\r\n        diy: 'linear-gradient(135deg, #FFAB91, #FF7043)'\r\n      }\r\n      return colors[id] || 'linear-gradient(135deg, #E0E0E0, #BDBDBD)'\r\n    },\r\n    openArticle(article) {\r\n      article.views = (article.views || 0) + 1\r\n      this.selectedArticle = article\r\n      this.saveArticles()\r\n    },\r\n    likeArticle(article) {\r\n      article.likes = (article.likes || 0) + 1\r\n      this.saveArticles()\r\n    },\r\n    publishArticle() {\r\n      if (!this.canPublish) return\r\n      const tags = this.newArticle.tags.split(',').map(t => t.trim()).filter(Boolean)\r\n      const article = {\r\n        id: Date.now(),\r\n        title: this.newArticle.title.trim(),\r\n        category: this.newArticle.category,\r\n        difficulty: this.newArticle.difficulty,\r\n        content: this.newArticle.content.trim(),\r\n        tags,\r\n        author: this.currentUser.name || this.currentUser.email || 'Anonymous',\r\n        readTime: Math.max(1, Math.ceil(this.newArticle.content.split(/\\s+/).length / 200)),\r\n        likes: 0,\r\n        views: 0,\r\n        date: new Date().toISOString()\r\n      }\r\n      this.articles.unshift(article)\r\n      this.saveArticles()\r\n      this.showCreateForm = false\r\n      this.newArticle = { title: '', category: '', difficulty: 'beginner', content: '', tags: '' }\r\n    },\r\n    loadArticles() {\r\n      const saved = localStorage.getItem('susty_knowledge')\r\n      if (saved) {\r\n        this.articles = JSON.parse(saved)\r\n      } else {\r\n        this.articles = [\r\n          { id: 1, title: 'Complete Guide to Home Composting', category: 'composting', difficulty: 'beginner', content: 'Composting is one of the most effective ways to reduce household waste while creating nutrient-rich soil for your garden.\\n\\nGetting Started:\\nYou\\'ll need a compost bin or designated area in your yard. Choose a spot that gets partial sunlight.\\n\\nWhat to Compost:\\n- Fruit and vegetable scraps\\n- Coffee grounds and tea bags\\n- Eggshells\\n- Yard waste (leaves, grass clippings)\\n- Newspaper and cardboard\\n\\nWhat NOT to Compost:\\n- Meat or dairy products\\n- Diseased plants\\n- Pet waste\\n\\nThe Process:\\n1. Layer green (nitrogen-rich) and brown (carbon-rich) materials\\n2. Keep the pile moist but not waterlogged\\n3. Turn the pile every 1-2 weeks\\n4. In 2-6 months, you\\'ll have rich, dark compost!\\n\\nTroubleshooting:\\n- Smelly pile: Add more brown materials\\n- Slow decomposition: Add more green materials and moisture\\n- Pests: Avoid adding meat and cover food scraps with brown materials', tags: ['composting', 'garden', 'zero-waste'], author: 'GreenGuru', readTime: 5, likes: 42, views: 230, date: '2026-03-15T10:00:00Z' },\r\n          { id: 2, title: 'Minimalism: Start with 30 Days', category: 'minimalism', difficulty: 'beginner', content: 'The 30-day minimalism challenge is a simple way to declutter your life and reduce consumption.\\n\\nThe Rules:\\nDay 1: Remove 1 item\\nDay 2: Remove 2 items\\nDay 3: Remove 3 items\\n...and so on!\\n\\nBy the end of 30 days, you\\'ll have removed 465 items from your home. Donate, recycle, or sell them on the Susty Marketplace!\\n\\nTips for Success:\\n- Start with easy areas (junk drawer, closet)\\n- Take photos before and after\\n- Don\\'t just throw things away — find them new homes\\n- Involve your family or roommates\\n\\nBenefits:\\n- Less clutter, more space\\n- Reduced environmental impact\\n- More money from selling unused items\\n- Mental clarity and reduced stress', tags: ['minimalism', 'declutter', 'challenge'], author: 'MinimalMike', readTime: 3, likes: 35, views: 185, date: '2026-03-10T14:00:00Z' },\r\n          { id: 3, title: 'Save 40% on Your Energy Bill', category: 'energy', difficulty: 'intermediate', content: 'Small changes can dramatically reduce your home energy consumption.\\n\\nQuick Wins:\\n1. Switch to LED bulbs — saves 75% energy per bulb\\n2. Unplug phantom loads (chargers, standby devices)\\n3. Use a programmable thermostat\\n4. Seal windows and doors\\n\\nMedium Investments:\\n1. Install smart power strips\\n2. Add window film or thermal curtains\\n3. Upgrade to energy-efficient appliances\\n4. Install low-flow showerheads\\n\\nBigger Projects:\\n1. Add insulation to walls and attic\\n2. Install solar panels\\n3. Upgrade HVAC system\\n4. Install a heat pump\\n\\nTracking Progress:\\nUse your utility bills to track savings month over month. Most energy companies offer online tools to monitor usage patterns.', tags: ['energy', 'savings', 'home'], author: 'EcoEngineer', readTime: 4, likes: 58, views: 310, date: '2026-03-05T09:00:00Z' },\r\n          { id: 4, title: 'Repair Your Electronics Instead of Replacing', category: 'diy', difficulty: 'intermediate', content: 'Electronic waste is one of the fastest-growing waste streams. Learning basic repair skills can save money and reduce e-waste.\\n\\nCommon Repairs Anyone Can Do:\\n- Replace cracked phone screens\\n- Swap laptop batteries\\n- Fix loose cables and connectors\\n- Clean clogged fans\\n\\nTools You\\'ll Need:\\n- Precision screwdriver set\\n- Spudger/pry tools\\n- Isopropyl alcohol\\n- Compressed air\\n- Multimeter (for advanced repairs)\\n\\nResources:\\n- iFixit.com for free repair guides\\n- YouTube repair tutorials\\n- Local repair cafés\\n- Susty community forums\\n\\nWhen to Repair vs Replace:\\n- If repair cost < 50% of replacement, repair\\n- Consider the environmental cost, not just price\\n- A repaired device is always greener than a new one', tags: ['repair', 'electronics', 'diy', 'e-waste'], author: 'RepairRick', readTime: 4, likes: 31, views: 165, date: '2026-02-28T11:00:00Z' },\r\n          { id: 5, title: 'Sustainable Wardrobe: A Beginner\\'s Guide', category: 'fashion', difficulty: 'beginner', content: 'The fashion industry is one of the world\\'s largest polluters. Building a sustainable wardrobe is easier than you think.\\n\\nThe Capsule Wardrobe:\\nA capsule wardrobe consists of 30-40 versatile pieces that mix and match. Focus on quality over quantity.\\n\\nSustainable Shopping Tips:\\n1. Buy secondhand first\\n2. Choose natural fibers (organic cotton, linen, hemp)\\n3. Avoid fast fashion brands\\n4. Look for certifications (GOTS, Fair Trade)\\n5. Support local designers\\n\\nCare Tips:\\n- Wash clothes less frequently\\n- Use cold water\\n- Air dry when possible\\n- Learn basic mending skills\\n- Use eco-friendly detergents\\n\\nSwapping & Trading:\\nUse the Susty Marketplace to trade clothes you no longer wear. One person\\'s old outfit is another\\'s treasure!', tags: ['fashion', 'clothing', 'sustainable', 'capsule-wardrobe'], author: 'EcoFashionista', readTime: 4, likes: 45, views: 256, date: '2026-02-20T15:00:00Z' },\r\n          { id: 6, title: 'Water Conservation at Home', category: 'water', difficulty: 'beginner', content: 'Fresh water is a precious resource. Here\\'s how to reduce your household water usage by up to 50%.\\n\\nBathroom:\\n- Install low-flow showerheads (saves 2,700 gallons/year)\\n- Turn off tap while brushing teeth\\n- Shorter showers (5 min max)\\n- Fix leaky faucets immediately\\n\\nKitchen:\\n- Only run dishwasher when full\\n- Use a basin for hand-washing dishes\\n- Don\\'t pre-rinse dishes\\n- Compost food waste instead of using the garbage disposal\\n\\nOutdoor:\\n- Water plants early morning or evening\\n- Use drip irrigation\\n- Collect rainwater\\n- Choose native, drought-resistant plants\\n- Use mulch to retain moisture\\n\\nTracking:\\nMonitor your water bill monthly. A family of 4 should aim for under 80 gallons per person per day.', tags: ['water', 'conservation', 'home'], author: 'WaterWise', readTime: 3, like