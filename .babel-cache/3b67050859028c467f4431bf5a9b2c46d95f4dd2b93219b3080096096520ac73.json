{"ast":null,"code":"export default {\n  name: 'AboutView',\n  data() {\n    return {\n      team: [{\n        name: 'Sairam',\n        position: 'Chief Sorcerer',\n        photo: require('@/assets/team-photos/sairam.jpg')\n      }, {\n        name: 'Amreish',\n        position: 'Network Magus',\n        photo: require('@/assets/team-photos/amreish.jpg')\n      }, {\n        name: 'Viggnan',\n        position: 'Product Magician',\n        photo: require('@/assets/team-photos/viggnan.jpeg')\n      }, {\n        name: 'Mhilan',\n        position: 'Spellmaster of Tech',\n        photo: require('@/assets/team-photos/mhilan.jpg')\n      }, {\n        name: 'Rachana',\n        position: 'Masters of Charms',\n        photo: require('@/assets/team-photos/rachana.jpg')\n      }]\n    };\n  }\n};","map":{"version":3,"names":["name","data","team","position","photo","require"],"sources":["/home/rare/projects/susty/src/views/About.vue"],"sourcesContent":["<template>\n  <div class=\"about\">\n    <section class=\"mission-vision\">\n      <div class=\"mission\">\n        <h3>Mission</h3>\n        <p>To build a vibrant community of sustainability enthusiasts who share and celebrate eco-friendly ideas, actions, events, and products, inspiring the world to embrace a greener lifestyle. To become the world's largest e-commerce platform and aggregator for sustainable products.</p>\n      </div>\n      <div class=\"vision\">\n        <h3>Vision</h3>\n        <p>To become a technology leader of sustainability-related innovative products for residential, commercial, and industrial applications leveraging artificial intelligence and analytics that contribute to a greener future.</p>\n      </div>\n    </section>\n    \n    <section class=\"team\">\n      <h3>Meet Our Team</h3>\n      <div class=\"team-grid\">\n        <div class=\"team-member\" v-for=\"member in team\" :key=\"member.name\">\n          <img :src=\"member.photo\" :alt=\"member.name\" class=\"team-photo\" />\n          <h4>{{ member.name }}</h4>\n          <p><strong>{{ member.position }}</strong></p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"goals\">\n      <h3>Our Goals</h3>\n      <ul>\n        <li>Build a community of sustainability-minded individuals</li>\n        <li>Create influencers in sustainability</li>\n        <li>Focus on areas like Education, Social, Products, Influencer, Food, Medical, Volunteering</li>\n      </ul>\n    </section>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'AboutView',\n  data() {\n    return {\n      team: [\n        { name: 'Sairam', position: 'Chief Sorcerer', photo: require('@/assets/team-photos/sairam.jpg') },\n        { name: 'Amreish', position: 'Network Magus', photo: require('@/assets/team-photos/amreish.jpg') },\n        { name: 'Viggnan', position: 'Product Magician', photo: require('@/assets/team-photos/viggnan.jpeg') },\n        { name: 'Mhilan', position: 'Spellmaster of Tech', photo: require('@/assets/team-photos/mhilan.jpg') },\n        { name: 'Rachana', position: 'Masters of Charms', photo: require('@/assets/team-photos/rachana.jpg') }\n      ]\n    }\n  }\n}\n</script>\nSairam: Co-Founder & Chief Sorcerer\nAmreish: Co-Founder & Network Magus\nMhilan: Chief Tech Wizard\nViggnan: Product Conjurer\nRachana: Co-Founder & Brand Enchanter\n<style scoped>\n.mission-vision {\n  display: flex;\n  gap: 2rem;\n  margin-bottom: 2rem;\n}\n\n.mission, .vision {\n  flex: 1;\n  background-color: white;\n  padding: 2rem;\n  border-radius: 10px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n}\n\n.team, .goals {\n  background-color: white;\n  padding: 2rem;\n  border-radius: 10px;\n  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  margin-bottom: 2rem;\n}\n\n.team-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 2rem;\n}\n\n.team-member {\n  text-align: center;\n}\n\n.team-photo {\n  width: 150px;\n  height: 150px;\n  object-fit: cover;\n  border-radius: 50%;\n  margin-bottom: 1rem;\n  border: 3px solid #4CAF50; /* Green border */\n}\n\n.goals ul {\n  list-style-type: none;\n  padding: 0;\n}\n\n.goals li {\n  background-color: #e7f3e7;\n  margin: 0.5rem 0;\n  padding: 1rem;\n  border-radius: 5px;\n}\n</style>"],"mappings":"AAoCA,eAAe;EACbA,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,CACJ;QAAEF,IAAI,EAAE,QAAQ;QAAEG,QAAQ,EAAE,gBAAgB;QAAEC,KAAK,EAAEC,OAAO,CAAC,iCAAiC;MAAE,CAAC,EACjG;QAAEL,IAAI,EAAE,SAAS;QAAEG,QAAQ,EAAE,eAAe;QAAEC,KAAK,EAAEC,OAAO,CAAC,kCAAkC;MAAE,CAAC,EAClG;QAAEL,IAAI,EAAE,SAAS;QAAEG,QAAQ,EAAE,kBAAkB;QAAEC,KAAK,EAAEC,OAAO,CAAC,mCAAmC;MAAE,CAAC,EACtG;QAAEL,IAAI,EAAE,QAAQ;QAAEG,QAAQ,EAAE,qBAAqB;QAAEC,KAAK,EAAEC,OAAO,CAAC,iCAAiC;MAAE,CAAC,EACtG;QAAEL,IAAI,EAAE,SAAS;QAAEG,QAAQ,EAAE,mBAAmB;QAAEC,KAAK,EAAEC,OAAO,CAAC,kCAAkC;MAAE;IAEzG;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}